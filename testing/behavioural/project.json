{
  "name": "ag-behavioural-testing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "testing/behavioural",
  "projectType": "library",
  "targets": {
    "lint": {
      "command": "eslint",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "command": "npx vitest run --project ag-behavioural-testing",
      "outputs": ["{workspaceRoot}/reports/ag-behavioural-testing.xml"],
      "configurations": {
        "ci": {},
        "watch": {},
        "update": {}
      }
    },
    "benchmark": {
      "command": "vitest bench --run",
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "watch": {
          "watch": true
        },
        "update": {
          "update": true
        }
      }
    }
  },
  "tags": ["test", "module"]
}
