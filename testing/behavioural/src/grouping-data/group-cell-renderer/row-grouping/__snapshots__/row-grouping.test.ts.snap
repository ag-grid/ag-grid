exports[`ag-grid groupCellRenderer > with rowModelType=clientSide > correct values are displayed > with the default renderer > groupDisplayType=multipleColumns > groupHideOpenParents=false > showOpenedGroup=false > colDef[1].valueFormatter=undefined > autoGroupColumnDef.valueGetter=(p) => \`autoColDef.valueGetter(\${p.data?.athlete ?? "MISSING"})\` > autoGroupColumnDef.valueFormatter=(p) => \`autoColDef.valueFormatter(\${p.value})\` > autoGroupColumnDef.cellRendererParams.totalValueGetter=undefined 1`] = `
