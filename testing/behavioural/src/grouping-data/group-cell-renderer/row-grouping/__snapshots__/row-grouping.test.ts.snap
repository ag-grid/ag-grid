exports[`ag-grid groupCellRenderer > with rowModelType=clientSide > correct values are displayed > with the default renderer > groupDisplayType=multipleColumns > groupHideOpenParents=false > showOpenedGroup=false > colDef[1].valueFormatter=(p) => \`columnDef[1].valueFormatter(\${p.value})\` > autoGroupColumnDef.valueGetter=(p) => \`autoColDef.valueGetter(\${p.data?.athlete ?? "MISSING"})\` > autoGroupColumnDef.valueFormatter=undefined > autoGroupColumnDef.cellRendererParams.totalValueGetter=(p) => \`autoColDef.cellRendererParams.totalValueGetter(\${p.valueFormatted ?? p.value})\` 1`] = `
