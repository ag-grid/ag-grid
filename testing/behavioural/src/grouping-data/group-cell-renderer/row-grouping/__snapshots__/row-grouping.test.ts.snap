exports[`ag-grid groupCellRenderer > with rowModelType=serverSide > correct values are displayed > with an autoColDef.cellRenderer.innerRenderer > groupDisplayType=multipleColumns > groupHideOpenParents=false > showOpenedGroup=false > colDef[1].valueFormatter=undefined > autoGroupColumnDef.valueGetter=(p) => \`autoColDef.valueGetter(\${p.data?.athlete ?? "MISSING"})\` > autoGroupColumnDef.valueFormatter=undefined > autoGroupColumnDef.cellRendererParams.totalValueGetter=undefined 1`] = `
