exports[`ag-grid groupCellRenderer > with rowModelType=serverSide > correct renderer is used > groupDisplayType=multipleColumns > groupHideOpenParents=false > showOpenedGroup=true > autoGroupColumnDef.cellRendererParams.innerRenderer=(p) => \`autoColDef.cellRendererParams.innerRenderer(\${p.valueFormatted ?? p.value})\` > colDef[1].cellRenderer=(p) => \`columnDef[1].cellRenderer(\${p.valueFormatted ?? p.value})\` 1`] = `
[
