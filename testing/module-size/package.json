{
  "name": "ag-grid-module-size",
  "private": true,
  "version": "35.2.1",
  "scripts": {
    "dev": "vite",
    "cp-app": "cp ./src/App_Src.tsx ./src/App_AUTO.tsx",
    "build-app": "vite build",
    "build": "run-s cp-app build-app",
    "preview": "vite preview",
    "module-combinations": "tsx moduleCombinations.ts",
    "module-stats": "tsx moduleCombinations.ts && npm run module-validate",
    "module-validate": "tsx moduleValidator.ts",
    "test:e2e": "run-s \"module-combinations -- {1}\" module-validate --"
  },
  "dependencies": {
    "ag-grid-react": "35.2.1",
    "ag-grid-community": "35.2.1",
    "ag-grid-enterprise": "35.2.1",
    "ag-charts-community": "13.2.1",
    "ag-charts-enterprise": "13.2.1",
    "ag-shared": "0.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "terser": "^5.36.0",
    "npm-run-all": "^4.1.5"
  }
}
