{
  "name": "stylelint-plugin-ag",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "plugins/stylelint-plugin-ag",
  "projectType": "library",
  "targets": {
    "test": {
      "command": "npx vitest run --project stylelint-plugin-ag",
      "inputs": ["default", "{projectRoot}/**/*.mjs"],
      "configurations": {
        "ci": {},
        "watch": {},
        "update": {}
      }
    },
    "lint": {
      "command": "eslint",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": []
}
