{
  "name": "ag-stack",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ag-stack/src",
  "projectType": "library",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["{workspaceRoot}/scripts/ci/install-playwright.sh full chromium"],
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:noop",
      "inputs": [],
      "outputs": [],
      "dependsOn": ["build:types", "build:package", "build:package:core", "build:umd"]
    },
    "build:umd": {
      "executor": "ag-grid-task-autogen:esbuild-staged",
      "dependsOn": ["^build:package", "build:package"],
      "inputs": ["tsDefaults", "styleOutputs"],
      "outputs": ["{projectRoot}/dist/ag-stack*.js"],
      "options": {
        "skipTypeCheck": true,
        "outputPath": "{projectRoot}/dist",
        "main": "{projectRoot}/src/main-umd.ts",
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "esbuildConfig": "packages/ag-stack/esbuildBuild.cjs",
        "platform": "browser",
        "target": "es2020",
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": true,
        "sourcemap": false,
        "metafile": false
      },
      "cache": true
    },
    "build:umd:watch": {
      "executor": "ag-grid-task-autogen:esbuild-staged",
      "dependsOn": [],
      "inputs": ["tsDefaults", "styleOutputs"],
      "outputs": ["{projectRoot}/dist/ag-stack*.js"],
      "options": {
        "skipTypeCheck": true,
        "outputPath": "{projectRoot}/dist",
        "main": "{projectRoot}/src/main-umd.ts",
        "tsConfig": "{projectRoot}/tsconfig.watch.json",
        "esbuildConfig": "packages/ag-stack/esbuildBuild.cjs",
        "platform": "browser",
        "target": "es2020",
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": true,
        "sourcemap": false,
        "metafile": false
      },
      "configurations": {
        "watch": {}
      },
      "cache": true
    },
    "build:types": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build:types"],
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsconfig.*.json",
        "tsDeclarations",
        "sharedGlobals",
        "defaultExcludes",
        {
          "externalDependencies": ["npm:typescript", "npm:esbuild"]
        }
      ],
      "outputs": ["{projectRoot}/dist/types"],
      "options": {
        "command": "node scripts/package/emit-declarations.mjs {projectRoot}/tsconfig.types.json {projectRoot}/dist/types"
      },
      "configurations": {
        "watch": {
          "command": "node scripts/package/emit-declarations.mjs {projectRoot}/tsconfig.types.watch.json {projectRoot}/dist/types"
        },
        "production": {}
      }
    },
    "build:package": {
      "executor": "ag-grid-task-autogen:esbuild-staged",
      "dependsOn": ["^build:package"],
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsconfig.*.json",
        "tsDeclarations",
        "sharedGlobals",
        "defaultExcludes",
        {
          "externalDependencies": ["npm:typescript", "npm:esbuild"]
        }
      ],
      "outputs": ["{options.outputPath}"],
      "options": {
        "skipTypeCheck": true,
        "outputPath": "{projectRoot}/dist/package",
        "main": "{projectRoot}/src/main.ts",
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "esbuildConfig": "esbuild.config.cjs",
        "platform": "browser",
        "target": "es2020",
        "format": ["cjs", "esm"],
        "sourcemap": true,
        "metafile": false
      },
      "configurations": {
        "watch": {
          "tsConfig": "{projectRoot}/tsconfig.watch.json"
        },
        "staging": {
          "sourcemap": false,
          "metafile": false
        },
        "production": {
          "sourcemap": false,
          "metafile": false
        }
      }
    },
    "build:package:core": {
      "executor": "ag-grid-task-autogen:esbuild-staged",
      "dependsOn": ["^build:package"],
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsconfig.*.json",
        "tsDeclarations",
        "sharedGlobals",
        "defaultExcludes",
        {
          "externalDependencies": ["npm:typescript", "npm:esbuild"]
        }
      ],
      "outputs": ["{options.outputPath}"],
      "options": {
        "skipTypeCheck": true,
        "outputPath": "{projectRoot}/dist/core",
        "main": "{projectRoot}/src/main-core.ts",
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "esbuildConfig": "esbuild.config.cjs",
        "platform": "neutral",
        "target": "es2020",
        "format": ["cjs", "esm"],
        "sourcemap": true,
        "metafile": false
      },
      "configurations": {
        "watch": {
          "tsConfig": "{projectRoot}/tsconfig.watch.json"
        },
        "staging": {
          "sourcemap": false,
          "metafile": false
        },
        "production": {
          "sourcemap": false,
          "metafile": false
        }
      }
    },
    "build:package:watch": {
      "executor": "ag-grid-task-autogen:esbuild-staged",
      "dependsOn": [],
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsconfig.*.json",
        "sharedGlobals",
        "defaultExcludes",
        {
          "externalDependencies": ["npm:esbuild"]
        }
      ],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "{projectRoot}/dist/package",
        "main": "{projectRoot}/src/main.ts",
        "tsConfig": "{projectRoot}/tsconfig.watch.json",
        "skipTypeCheck": true,
        "esbuildConfig": "esbuild.config.cjs",
        "platform": "browser",
        "target": "es2020",
        "format": ["cjs", "esm"],
        "sourcemap": true,
        "metafile": false
      },
      "configurations": {
        "watch": {}
      },
      "cache": true
    },
    "lint:knip": {
      "command": "knip",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "inputs": ["default", "^default", "eslintConfig", "stylelintConfig"],
      "dependsOn": ["lint:knip"],
      "options": {
        "command": "eslint && stylelint './src/**/*css'"
      }
    },
    "build:test": {
      "options": {
        "command": "npx tsc -p {projectRoot}/tsconfig.spec.json --noEmit && npx tsc -p {projectRoot}/tsconfig.core.json && npx tsc -p {projectRoot}/tsconfig.core.worker.json"
      }
    },
    "test": {
      "command": "npx vitest run",
      "dependsOn": ["build:test"],
      "outputs": ["{workspaceRoot}/reports/ag-stack.xml"],
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": ["allTransitiveOutputs"],
      "outputs": ["{workspaceRoot}/dist/artifacts/{projectRoot}.tgz"],
      "options": {
        "cwd": "{projectRoot}",
        "parallel": false,
        "commands": [
          "mkdir -p ../../dist/artifacts/{projectRoot}",
          "yarn pack -o ../../dist/artifacts/{projectRoot}.tgz",
          "rm -rf ../../dist/artifacts/{projectRoot}"
        ]
      }
    },
    "pack:extract": {
      "executor": "nx:run-commands",
      "dependsOn": ["pack"],
      "inputs": ["allOutputs"],
      "outputs": ["{workspaceRoot}/dist/artifacts/contents/{projectRoot}"],
      "options": {
        "command": "scripts/package/extract-contents.sh {projectRoot}"
      }
    },
    "pack:verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["pack:extract"],
      "inputs": ["allOutputs"],
      "options": {
        "commands": [
          "node scripts/package/sanity-check-package.js --allowed-ext css scss -- dist/artifacts/contents/{projectRoot}/package"
        ]
      },
      "configurations": {
        "production": {},
        "archive": {}
      }
    }
  },
  "tags": ["package", "stack", "core"]
}
