{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "declaration": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist/types",
    "types": ["vite/client"],
    "paths": {}
  },
  "include": ["src/main.ts", "src/typings.ts"],
  "exclude": ["src/main-styles.ts", "src/*.test.ts"]
}
