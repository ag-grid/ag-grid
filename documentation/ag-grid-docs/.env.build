# SE-85: Ghost's own sitemap index for the self-hosted blog. Unlike charts/studio (which expose a
# flat sitemap-0.xml) Ghost publishes an index at /blog/sitemap.xml pointing at four child sitemaps
# (posts, pages, authors, tags) — @astrojs/sitemap references it as-is, so the blog's entries stay
# current without this build knowing anything about them.
BLOG_SITEMAP_INDEX_URL=https://www.ag-grid.com/blog/sitemap.xml
