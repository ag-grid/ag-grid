# Dash0 website monitoring. The token is public by design (it ships in the page): ingest-only,
# scoped to the staging website dataset. Every build that does not set its own token
# (branch deploys, local previews) reports here; production overrides it
PUBLIC_DASH0_ENDPOINT_URL=https://ingress.eu-west-1.aws.dash0.com
PUBLIC_DASH0_AUTH_TOKEN=auth_rAYyqBAwV4aO3fekRBaDRSPeywNAcYPH

# Use production sitemap/robots disallow
LIVE_SITEMAP_URL=https://grid-staging.ag-grid.com/sitemap-0.xml
CHARTS_SITEMAP_INDEX_URL=https://www.ag-grid.com/charts/sitemap-0.xml
CHARTS_ROBOTS_DISALLOW_JSON_URL=https://www.ag-grid.com/charts/robots-disallow.json
STUDIO_SITEMAP_INDEX_URL=https://www.ag-grid.com/studio/sitemap-0.xml
STUDIO_ROBOTS_DISALLOW_JSON_URL=https://www.ag-grid.com/studio/robots-disallow.json
# The blog's sitemap-tags.xml is deliberately absent: every tag archive page it lists is
# noindex, so listing it would only send crawlers to pages we tell them not to index.
BLOG_SITEMAP_URLS=https://www.ag-grid.com/blog/sitemap-posts.xml,https://www.ag-grid.com/blog/sitemap-pages.xml,https://www.ag-grid.com/blog/sitemap-authors.xml
