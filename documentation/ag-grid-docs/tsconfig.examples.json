{
  // Type-checks the driving `main.ts` of every documentation example (the vanilla source the
  // framework variants are generated from). Grid packages resolve to their built `dist/types`
  // (via node_modules), and the shared example globals (IOlympicData, etc.) come from src/types.
  //
  // This is a deliberately lenient starting gate: `strict` is off so the check focuses on
  // high-value breakages (missing/renamed APIs, wrong option shapes) without drowning in the
  // implicit-any / evolving-array noise inherent to the loosely-typed example style.
  //
  // `provided/` framework variants are out of scope here — they import generator-injected
  // siblings (./interfaces, ./useFetchJson) that only exist post-generation.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": ["node"]
  },
  "include": ["src/types/**/*.d.ts", "src/content/docs/**/_examples/**/main.ts"],
  "exclude": [
    "src/content/docs/**/_examples/**/provided/**",

    // Deferred: examples that still fail the lenient check and need follow-up. The bulk are the
    // Server-Side Row Model and Viewport examples, which share a constructor-function
    // (`new MockServer(...)` / `new ViewportDatasource(...)`) pattern TypeScript flags. Grow the
    // gate by fixing these and removing entries.
    "src/content/docs/server-side-model-*/_examples/**",
    "src/content/docs/viewport/_examples/**",
    "src/content/docs/ai-toolkit/_examples/natural-language-grid-state/**",
    "src/content/docs/ai-toolkit/_examples/tool-panel-chat-assistant/**",
    "src/content/docs/cell-editing-batch-test/_examples/batch-editing/**",
    "src/content/docs/column-groups/_examples/hide-padded-header-rows/**",
    "src/content/docs/column-headers-components/_examples/header-template/**",
    "src/content/docs/column-headers/_examples/header-tooltip/**",
    "src/content/docs/component-cell-renderer/_examples/lazy-renderer/**",
    "src/content/docs/dev-validation-test/_examples/multi-grid-attribution/**",
    "src/content/docs/excel-export-extra-content/_examples/excel-export-header-footer/**",
    "src/content/docs/excel-export-extra-content/_examples/excel-export-header-image/**",
    "src/content/docs/grouping-edit/_examples/pivot-editable-totals-custom/**",
    "src/content/docs/grouping-group-rows/_examples/renderer-config-custom/**",
    "src/content/docs/grouping-group-rows/_examples/renderer-config-inner/**",
    "src/content/docs/grouping-multiple-group-columns/_examples/renderer-config-custom/**",
    "src/content/docs/grouping-multiple-group-columns/_examples/renderer-config-group-cell/**",
    "src/content/docs/grouping-multiple-group-columns/_examples/renderer-config-inner/**",
    "src/content/docs/grouping-row-dragging/_examples/unmanaged-row-group-drag/**",
    "src/content/docs/grouping-single-group-column/_examples/renderer-config-custom/**",
    "src/content/docs/grouping-single-group-column/_examples/renderer-config-group-cell/**",
    "src/content/docs/grouping-single-group-column/_examples/renderer-config-inner/**",
    "src/content/docs/overlays-active/_examples/active-overlay-switcher/**",
    "src/content/docs/row-sorting/_examples/absolute-sorting/**",
    "src/content/docs/sparklines-bar-customisation/_examples/bar-sparkline-progress-bars/**",
    "src/content/docs/toolbar/_examples/action-buttons/**",
    "src/content/docs/tree-data-group-column/_examples/custom-component/**",
    "src/content/docs/tree-data-group-column/_examples/dynamic-component/**",
    "src/content/docs/tree-data-row-dragging/_examples/tree-unmanaged-row-drag-with-parent-id/**"
  ]
}
