### AUTOGENERATED DO NOT EDIT
ErrorDocument 404 /studio/404.html

# add MIME types for serving example files
AddType text/javascript mjs ts jsx

# Apache has no built-in .webp type, so without this the images are served with no Content-Type.
AddType image/webp .webp

# serve the per-page LLM markdown files as markdown
AddType text/markdown md
# ...as UTF-8, so glyphs like ✓/✗ in generated tables aren't mojibaked by a
# Latin-1 fallback (the .md endpoint sets this charset; static hosting must too).
AddCharset utf-8 .md

# Content-Security-Policy — path-scoped. Studio is served from /studio on www.ag-grid.com
# and inherits the grid root CSP, so this block overrides it for studio pages (see
# getCspHtaccessBlock). Ordinary pages get the tightened policy (no 'unsafe-eval'); the
# <If> override re-allows it for example-runner documents. The trial-form origin is
# env-split, so the policy is generated per environment.
# Override the CSP inherited from the grid root for /studio pages.
Header always unset Content-Security-Policy
Header always unset Content-Security-Policy-Report-Only
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' blob: https://*.ag-grid.com https://plausible.io https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://esm.sh https://bryntum.com https://js.zi-scripts.com https://*.zoominfo.com https://snap.licdn.com https://googleads.g.doubleclick.net https://www.google.com https://www.gstatic.com https://www.youtube.com https://cdn.cookielaw.org https://app.enzuzo.com 'wasm-unsafe-eval' 'sha256-OshqkX0J+NG9AexajdQvXWHVftyvsnF5TX+adf272gM=' 'sha256-yyPoC+PtF+Rve9JwzJ4PTIiap268jewQfmi4/JViA6I=' 'sha256-2FkRaRTcR5gCsv4n2zqqqLpAuXDH81zr4eNak8Aw5QA=' 'sha256-V9qR5YoG9UXRYIHiPULjYjKYPy3t6rsOFgm0VUI5TzE=' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-eIXWvAmxkr251LJZkjniEK5LcPF3NkapbJepohwYRIc=' 'sha256-Q2BPg90ZMplYY+FSdApNErhpWafg2hcRRbndmvxuL/Q=' 'sha256-BF0290pkb3jxQsE7z00xR8Imp8X34FLC88L0lkMnrGw=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U=' 'sha256-41l+jvtOjBgKy9345IStB4j1gGPGFMVXADMHn1Acs6E=' 'sha256-NSYHvOQXo5WNxDt0/+l9AbSTx6N4CkkrbuSSa6ERhlo=' 'sha256-UZ79CQlmQa9u4xp1a60kP2//w3o9IvBsC2tdqv57moc=' 'sha256-7f34QP24yF/YC+G6zSHRCBZrBez6xFf6GbcGIXkZ4K0=' 'sha256-7slCn/usH14D/QjSBhHPAkSInIZY56XqT8LTtYE71U8=' 'sha256-D3cdipua6lhS2IQ0W0AlSNVVsS+2b/sXycSE8m8PkxY=' 'sha256-nC2/ZWBpMyJEdVw5YxKBKxSMNwMN/lOAPrHk4RcIBbc='; style-src 'self' https://fonts.googleapis.com https://bryntum.com https://use.fontawesome.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com https://bryntum.com https://use.fontawesome.com https://cdn.jsdelivr.net data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.ag-grid.com https://plausible.io https://*.algolia.net https://*.algolianet.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://stats.g.doubleclick.net https://www.googleadservices.com https://pagead2.