# X-Frame-Options intentionally omitted: it can't allow-list subdomains, so it blocks
# blog.ag-grid.com (and other *.ag-grid.com) from embedding examples. Clickjacking
# protection is handled by the CSP frame-ancestors directive instead (see cspRules.ts).
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

# SE-80: negotiated pages content-negotiate on Accept (see the markdown rewrite), so shared
# caches must key on it. Scoped to the negotiated paths so the rest of the site keeps its default.
<If "%{REQUEST_URI} =~ m#^/(?:(?:react|angular|vue|javascript)-data-grid/[^/.]+|about|changelog|documentation-archive|example|license-pricing|pipeline|roadmap|whats-new|community(?:/(?:beyond-the-prompt|events|media|showcase|tools-extensions))?|session/[^/.]+|campaigns/bryntum-[^/.]+|landing-pages/[^/.]+|react-table|cookies|modern-slavery|privacy|terms-of-use|example-(?:finance|hr|inventory)|contact|niall|licensing|reference|sitemap|theme-builder)/?$# || %{REQUEST_URI} == '/'">
    Header append Vary Accept
</If>

Header set Link "</llms.txt>; rel=describedby, </sitemap-index.xml>; rel=sitemap, <https://www.ag-grid.com/javascript-data-grid/mcp-server/>; rel=related" "expr=%{REQUEST_STATUS} == 200 && %{CONTENT_TYPE} =~ m#^text/html#"

# Content-Security-Policy — enforced, path-scoped (the report-only validation window
# for removing 'unsafe-eval' from the main-site policy is complete). The block unsets
# the inherited headers (incl. the legacy wildcard CSP on the vhost) and sets this
# tightened policy as the enforced CSP. If the vhost wildcard lingers as a separate
# header, browsers enforce the intersection, so the tightened policy still wins;
# removing the vhost wildcard line is a follow-up infra cleanup.
# Override the CSP set on the staging vhost (the legacy wildcard).
Header always unset Content-Security-Policy
Header always unset Content-Security-Policy-Report-Only
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://*.ag-grid.com https://plausible.io https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net https://esm.sh https://cdnjs.cloudflare.com https://js.zi-scripts.com https://*.zoominfo.com https://snap.licdn.com https://googleads.g.doubleclick.net https://www.google.com https://www.gstatic.com https://apis.google.com https://www.youtube.com https://app.enzuzo.com blob: 'wasm-unsafe-eval' 'sha256-2U4ySWdNd6rjqv2m+dMFO0sF/XTsx0BraJMW2yLGCbk=' 'sha256-yyPoC+PtF+Rve9JwzJ4PTIiap268jewQfmi4/JViA6I=' 'sha256-2FkRaRTcR5gCsv4n2zqqqLpAuXDH81zr4eNak8Aw5QA=' 'sha256-V9qR5YoG9UXRYIHiPULjYjKYPy3t6rsOFgm0VUI5TzE=' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-eIXWvAmxkr251LJZkjniEK5LcPF3NkapbJepohwYRIc=' 'sha256-Q2BPg90ZMplYY+FSdApNErhpWafg2hcRRbndmvxuL/Q=' 'sha256-BF0290pkb3jxQsE7z00xR8Imp8X34FLC88L0lkMnrGw=' 'sha256-BrDhGE1lwa85arfXcrBxSo+n37uVSX5CAROXnIM6Q+g=' 'sha256-41l+jvtOjBgKy9345IStB4j1gGPGFMVXADMHn1Acs6E=' 'sha256-NSYHvOQXo5WNxDt0/+l9AbSTx6N4CkkrbuSSa6ERhlo=' 'sha256-nsp/0430/yfuSNjsteV2fUwjHINMowl9qldFKy6PKJs=' 'sha256-7f34QP24yF/YC+G6zSHRCBZrBez6xFf6GbcGIXkZ4K0=' 'sha256-1biJs72+znqmnYHTG0Ps3v04No9BtvG8+3CNYyK5djo=' 'sha256-D3cdipua6lhS2IQ0W0AlSNVVsS+2b/sXycSE8m8PkxY=' 'sha256-nC2/ZWBpMyJEdVw5YxKBKxSMNwMN/lOAPrHk4RcIBbc='; style-src 'self' https://fonts.googleapis.com https://use.fontawesome.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com https://use.fontawesome.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.ag-grid.com https://plausible.io https://*.algolia.net https://*.algolianet.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://stats.g.doubleclick.net https://flagcdn.com https://www.googletagmanager.com https://cdn.jsdelivr.net https://esm.sh https://cdnjs.cloudflare.com https://js.zi-scripts.com https://*.zoominfo.com https://px.ads.linkedin.com https://www.google.com https://www.googleadservices.com https://pagead2.googlesyndication.com https://ad.doubleclick.net https://app.enzuzo.com https://gvl.enzuzo.com https://hook.eu2.make.com https://www.googleapis.com https://securetoken.googleapis.com https://us-central1-aggrid-ecommerce.cloudfunctions.net; frame-src 'self' https://www.googletagmanager.com https://www.youtube.com https://www.google.com https://pay.realexpayments.com https://aggrid-ecommerce.firebaseapp.com; media-src 'self' data: blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://us-central1-aggrid-ecommerce.cloudfunctions.net https://webto.salesforce.com https://pay.realexpayments.com https://codesandbox.io https://plnkr.co https://ag-grid.us11.list-manage.com; frame-ancestors 'self' https://*.ag-grid.com"

# Example-runner documents and archived doc versions additionally need 'unsafe-eval'
# (the Angular JIT and Vue runtime template compilers compile in the browser;
# archived versions additionally eval-load modules with SystemJS), and the archived
# versions need the third-party hosts their legacy example runner and page chrome load from.
<If "%{REQUEST_URI} =~ m#^/(examples|archive)/#">
    Header always unset Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://*.ag-grid.com https://plausible.io https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net https://esm.sh https://cdnjs.cloudflare.com https://js.zi-scripts.com https://*.zoominfo.com https://snap.licdn.com https://googleads.g.doubleclick.net https://www.google.com https://www.gstatic.com https://apis.google.com https://www.youtube.com https://app.enzuzo.com blob: 'wasm-unsafe-eval' 'unsafe-eval' 'unsafe-inline' https://unpkg.com https://ajax.googleapis.com https://s3.amazonaws.com/downloads.mailchimp.com/js/mc-validate.js https://ag-grid.us11.list-manage.com https://platform.twitter.com https://buttons.github.io; style-src 'self' https://fonts.googleapis.com https://use.fontawesome.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'unsafe-inline' https://cdn-images.mailchimp.com https://maxcdn.bootstrapcdn.com; font-src 'self' https://fonts.gstatic.com https://use.fontawesome.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com data: https://maxcdn.bootstrapcdn.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.ag-grid.com https://plausible.io https://*.algolia.net https://*.algolianet.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://stats.g.doubleclick.net https://flagcdn.com https://www.googletagmanager.com https://cdn.jsdelivr.net https://esm.sh https://cdnjs.cloudflare.com https://js.zi-scripts.com https://*.zoominfo.com https://px.ads.linkedin.com https://www.google.com https://www.googleadservices.com https://pagead2.googlesyndication.com https://ad.doubleclick.net https://app.enzuzo.com https://gvl.enzuzo.com https://hook.eu2.make.com https://www.googleapis.com https://securetoken.googleapis.com https://us-central1-aggrid-ecommerce.cloudfunctions.net https://unpkg.com https://raw.githubusercontent.com; frame-src 'self' https://www.googletagmanager.com https://www.youtube.com https://www.google.com https://pay.realexpayments.com https://aggrid-ecommerce.firebaseapp.com https://platform.twitter.com https://buttons.github.io https://ghbtns.com; media-src 'self' data: blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://us-central1-aggrid-ecommerce.cloudfunctions.net https://webto.salesforce.com https://pay.realexpayments.com https://codesandbox.io https://plnkr.co https://ag-grid.us11.list-manage.com; frame-ancestors 'self' https://*.ag-grid.com"
