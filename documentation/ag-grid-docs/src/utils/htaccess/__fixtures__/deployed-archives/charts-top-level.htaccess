### AUTOGENERATED DO NOT EDIT
ErrorDocument 404 /charts/404.html

# add MIME types for serving example files
AddType text/javascript mjs ts jsx

# Apache has no built-in .webp type, so without this the images are served with no Content-Type.
AddType image/webp .webp

# serve the per-page LLM markdown files as markdown
AddType text/markdown md
# ...as UTF-8, so glyphs like ✓/✗ in generated tables aren't mojibaked by a
# Latin-1 fallback (the .md endpoint sets this charset; static hosting must too).
AddCharset utf-8 .md

# Content-Security-Policy — path-scoped. Charts is served from /charts on www.ag-grid.com
# and inherits the grid root CSP, so this block overrides it for charts pages (see
# getCspHtaccessBlock). Ordinary pages get the tightened policy (no 'unsafe-eval'); the
# <If> override re-allows it for example-runner documents. The trial-form origin is
# env-split, so the policy is generated per environment.
# Override the CSP inherited from the grid root for /charts pages.
Header always unset Content-Security-Policy
Header always unset Content-Security-Policy-Report-Only
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://*.ag-grid.com https://plausible.io https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net https://esm.sh https://js.zi-scripts.com https://*.zoominfo.com https://snap.licdn.com https://googleads.g.doubleclick.net https://www.google.com https://www.gstatic.com https://www.youtube.com https://cdn.cookielaw.org https://app.enzuzo.com blob: 'wasm-unsafe-eval' 'sha256-5yA1hhuz+tEuYcMxZ8ZGwNFlGOTnPuOk3MMRs7fYXmY=' 'sha256-yyPoC+PtF+Rve9JwzJ4PTIiap268jewQfmi4/JViA6I=' 'sha256-2FkRaRTcR5gCsv4n2zqqqLpAuXDH81zr4eNak8Aw5QA=' 'sha256-V9qR5YoG9UXRYIHiPULjYjKYPy3t6rsOFgm0VUI5TzE=' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-eIXWvAmxkr251LJZkjniEK5LcPF3NkapbJepohwYRIc=' 'sha256-Q2BPg90ZMplYY+FSdApNErhpWafg2hcRRbndmvxuL/Q=' 'sha256-BF0290pkb3jxQsE7z00xR8Imp8X34FLC88L0lkMnrGw=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U=' 'sha256-41l+jvtOjBgKy9345IStB4j1gGPGFMVXADMHn1Acs6E=' 'sha256-NSYHvOQXo5WNxDt0/+l9AbSTx6N4CkkrbuSSa6ERhlo=' 'sha256-UZ79CQlmQa9u4xp1a60kP2//w3o9IvBsC2tdqv57moc=' 'sha256-7f34QP24yF/YC+G6zSHRCBZrBez6xFf6GbcGIXkZ4K0=' 'sha256-7slCn/usH14D/QjSBhHPAkSInIZY56XqT8LTtYE71U8=' 'sha256-D3cdipua6lhS2IQ0W0AlSNVVsS+2b/sXycSE8m8PkxY=' 'sha256-nC2/ZWBpMyJEdVw5YxKBKxSMNwMN/lOAPrHk4RcIBbc='; style-src 'self' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https:; connect-src 'self' data: https://*.ag-grid.com https://plausible.io https://*.algolia.net https://*.algolianet.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://cdn.jsdelivr.net https://esm.sh https://js.zi-scripts.com https://*.zoominfo.com https://px.ads.linkedin.com https://www.google.com https://www.googleadservices.com https://pagead2.googlesyndication.com https://ad.doubleclick.net https://cdn.cookielaw.org https://*.onetrust.com https://app.enzuzo.com https://gvl.enzuzo.com https://hook.eu2.make.com https://us-central1-aggrid-ecommerce.cloudfunctions.net; frame-src 'self' data: https://www.googletagmanager.com https://www.youtube.com https://www.google.com; media-src 'self' data: blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://us-central1-aggrid-ecommerce.cloudfunctions.net https://webto.salesforce.com https://codesandbox.io https://plnkr.co https://ag-grid.us11.list-manage.com; frame-ancestors 'self' https://*.ag-grid.com"

# Example-runner documents and archived doc versions additionally need 'unsafe-eval'
# (the Angular JIT compiler and the Plunker transpiler compile in the browser;
# archived versions additionally eval-load modules with SystemJS).
# <If> sections merge after all other configuration, so this unset+set replaces the
# header set above for matching requests.
<If "%{REQUEST_URI} =~ m#/(examples/[^/?]|archive/)#">
    Header always unset Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://*.ag-grid.com https://plausible.io https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net https://esm.sh https://js.zi-scripts.com https://*.zoominfo.com https://snap.licdn.com https://googleads.g.doubleclick.net https://www.google.com https://www.gstatic.com https://www.youtube.com https://cdn.cookielaw.org https://app.enzuzo.com blob: 'wasm-unsafe-eval' 'unsafe-eval' 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https:; connect-src 'self' data: https://*.ag-grid.com https://plausible.io https://*.algolia.net https://*.algolianet.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://cdn.jsdelivr.net https://esm.sh https://js.zi-scripts.com https://*.zoominfo.com https://px.ads.linkedin.com https://www.google.com https://www.googleadservices.com https://pagead2.googlesyndication.com https://ad.doubleclick.net https://cdn.cookielaw.org https://*.onetrust.com https://app.enzuzo.com https://gvl.enzuzo.com https://hook.eu2.make.com https://us-central1-aggrid-ecommerce.cloudfunctions.net; frame-src 'self' data: https://www.googletagmanager.com https://www.youtube.com https://www.google.com; media-src 'self' data: blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://us-central1-aggrid-ecommerce.cloudfunctions.net https://webto.salesforce.com https://codesandbox.io https://plnkr.co https://ag-grid.us11.list-manage.com; frame-ancestors 'self' https://*.ag-grid.com"
</If>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonical host is www.ag-grid.com; the bare apex domain must not serve pages directly.
    RewriteCond %{HTTP_HOST} ^ag-grid\.com$ [NC]
    RewriteRule ^ https://www.ag-grid.com%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP_ACCEPT} text/markdown
    RewriteCond %{REQUEST_URI} ^/(charts/(?:(?:react|angular|vue|javascript)/[^/.]+|(?:react|angular|vue)|changelog|contact|documentation-archive|license-pricing|pipeline|roadmap|sitemap|whats-new|community(?:/(?:beyond-the-prompt|events|media|showcase|tools-extensions))?|session/[^/.]+|examples(?:-[^/.]+)?|gallery(?:/[^/.]+)?|(?:angular|enterprise|javascript|react|vue)-charts|options(?:/(?:axes|series|initialState/annotations|navigator/miniChart/series)/[^/.]+)?|themes-api(?:/overrides/[^/.]+)?))/?$
    RewriteCond %{DOCUMENT_ROOT}/%1.md -f
    RewriteRule ^ /%1.md [L]

    # The homepage twin (/charts/ -> /charts/index.md). Handled separately because the
    # site root has no path segment to capture in %1; the pattern matches only the base root.
    RewriteCond %{HTTP_ACCEPT} text/markdown
    RewriteCond %{REQUEST_URI} ^/charts/?$
    RewriteCond %{DOCUMENT_ROOT}/charts/index.md -f
    RewriteRule ^ /charts/index.md [L]
</IfModule>

# Docs pages content-negotiate on Accept (see the markdown rewrite), so shared caches must
# key on it. Scoped to the negotiated paths (incl. the homepage) so the rest of the site keeps
# its default.
<If "%{REQUEST_URI} =~ m#^/charts/(?:(?:react|angular|vue|javascript)/[^/.]+|(?:react|angular|vue)|changelog|contact|documentation-archive|license-pricing|pipeline|roadmap|sitemap|whats-new|community(?:/(?:beyond-the-prompt|events|media|showcase|tools-extensions))?|session/[^/.]+|examples(?:-[^/.]+)?|gallery(?:/[^/.]+)?|(?:angular|enterprise|javascript|react|vue)-charts|options(?:/(?:axes|series|initialState/annotations|navigator/miniChart/series)/[^/.]+)?|themes-api(?:/overrides/[^/.]+)?)/?$# || %{REQUEST_URI} =~ m#^/charts/?$#">
    Header append Vary Accept
</If>

Redirect 301 /charts/javascript/bullet-series /charts/javascript/linear-gauge/#bullet-series
Redirect 301 /charts/angular/bullet-series /charts/angular/linear-gauge/#bullet-series
Redirect 301 /charts/react/bullet-series /charts/react/linear-gauge/#bullet-series
Redirect 301 /charts/vue/bullet-series /charts/vue/linear-gauge/#bullet-series
Redirect 301 /charts/javascript/fonts /charts/javascript/text/
Redirect 301 /charts/angular/fonts /charts/angular/text/
Redirect 301 /charts/react/fonts /charts/react/text/
Redirect 301 /charts/vue/fonts /charts/vue/text/
RedirectMatch 301 "^/charts/javascript/?$" "/charts/javascript/quick-start/"
Redirect 301 /charts/javascript/toolbar/ /charts/javascript/financial-charts-toolbar/
Redirect 301 /charts/react/toolbar/ /charts/react/financial-charts-toolbar/
Redirect 301 /charts/react/line/ /charts/react/line-series/
Redirect 301 /charts/sitemap.xml /charts/sitemap-0.xml
RedirectMatch 301 "^/charts/archive/?$" "/charts/documentation-archive/"
RedirectMatch 410 "^/charts/privacy(/.*)?$"
RedirectMatch 301 "^/charts/javascript-charts/javascript/(.+)$" "/charts/javascript/$1"
RedirectMatch 301 "^/charts/angular-charts/angular/(.+)$" "/charts/angular/$1"
RedirectMatch 301 "^/charts/react-charts/react/(.+)$" "/charts/react/$1"
RedirectMatch 301 "^/charts/vue-charts/vue/(.+)$" "/charts/vue/$1"
RedirectMatch 301 "^/charts/enterprise-charts/react/(.+)$" "/charts/react/$1"
RedirectMatch 301 "^/charts/[a-z]+-charts/gallery(/.*)?$" "/charts/gallery/"
RedirectMatch 301 "^/charts/[a-z]+-charts/options(/.*)?$" "/charts/options/"
RedirectMatch 301 "^/charts/enterprise-charts/(?!index\.html$).+$" "/charts/enterprise-charts/"
RedirectMatch 301 "^/charts/core/(.*)" "/charts/javascript/$1"
RedirectMatch 301 "^/charts/side/(.*)" "/charts/javascript/$1"
RedirectMatch 301 "^/charts/server-side-rendering(/.*)?$" "/charts/javascript/server-side-rendering/"
RedirectMatch 301 "^/charts/(javascript|angular|react|vue)/series(/.*)?$" "/charts/$1/bar-series/"
RedirectMatch 301 "^/charts/(javascript|angular|react|vue)/axes(/.*)?$" "/charts/$1/axes-configuration/"

Options -Indexes
