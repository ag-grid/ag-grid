---
import LandingPageExampleRunner from './LandingPageExampleRunner.astro';
import { EnterpriseFeaturesContent } from './EnterpriseFeaturesContent';
import styles from './EnterpriseFeatures.module.scss';

// Define the examples that map to each feature tab (must match order in EnterpriseFeaturesContent.tsx)
const FEATURE_EXAMPLES = [
    {
        id: 'grouping-aggregation',
        pageName: 'grouping',
        exampleName: 'kitchen-sink',
        title: 'Grouping & Aggregation',
    },
    {
        id: 'tree-data',
        pageName: 'tree-data',
        exampleName: 'kitchen-sink',
        title: 'Tree Data',
    },
    {
        id: 'ssrm',
        pageName: 'server-side-model-configuration',
        exampleName: 'cache-configurations',
        title: 'Server-Side Row Model',
    },
    {
        id: 'excel-export',
        pageName: 'excel-export-styles',
        exampleName: 'excel-export-with-styles',
        title: 'Excel Export',
    },
    {
        id: 'ai-toolkit',
        pageName: 'ai-toolkit',
        exampleName: 'natural-language-grid-state',
        title: 'AI Toolkit',
    },
    {
        id: 'set-filter',
        pageName: 'filter-set',
        exampleName: 'enabling-set-filters',
        title: 'Set Filter',
    },
    {
        id: 'master-detail',
        pageName: 'master-detail',
        exampleName: 'simple',
        title: 'Master/Detail',
    },
    {
        id: 'context-menu',
        pageName: 'context-menu',
        exampleName: 'context-menu',
        title: 'Context Menu',
    },
];
---

<div class={styles.container}>
    <!-- Tabs at top -->
    <div class="enterprise-features-tabs">
        <EnterpriseFeaturesContent client:load />
    </div>

    <!-- Side by side layout: content left, example right -->
    <div class="enterprise-features-layout">
        <!-- Content column (controlled by React component via portal/slot) -->
        <div class="enterprise-content-column" id="enterprise-content-target">
            <!-- Content is rendered by EnterpriseFeaturesContent -->
        </div>

        <!-- Example runners column -->
        <div class="enterprise-examples-column">
            {FEATURE_EXAMPLES.map((example, index) => (
                <div
                    class={`enterprise-example-panel ${index === 0 ? 'active' : ''}`}
                    data-feature-id={example.id}
                    data-index={index}
                >
                    <LandingPageExampleRunner
                        title={example.title}
                        name={example.exampleName}
                        pageName={example.pageName}
                        exampleHeight={450}
                    />
                </div>
            ))}
        </div>
    </div>
</div>

<style lang="scss">
    @use 'design-system' as *;

    .enterprise-features-tabs {
        width: 100%;
        margin-bottom: $spacing-size-8;
    }

    .enterprise-features-layout {
        display: flex;
        flex-direction: row;
        gap: $spacing-size-8;
        width: 100%;

        @media screen and (max-width: $breakpoint-landing-page-medium) {
            flex-direction: column;
        }
    }

    .enterprise-content-column {
        flex: 0 0 40%;
        min-width: 0;

        @media screen and (max-width: $breakpoint-landing-page-medium) {
            flex: 1;
        }
    }

    .enterprise-examples-column {
        flex: 1;
        min-width: 0;
    }

    .enterprise-example-panel {
        display: none;
    }

    .enterprise-example-panel.active {
        display: block;
    }
</style>

<script>
    // Listen for tab changes from the React component
    document.addEventListener('enterprise-feature-tab-change', ((event: CustomEvent<{ index: number; featureId: string }>) => {
        const { index } = event.detail;

        // Hide all panels
        document.querySelectorAll('.enterprise-example-panel').forEach(panel => {
            panel.classList.remove('active');
        });

        // Show the selected panel
        const activePanel = document.querySelector(`.enterprise-example-panel[data-index="${index}"]`);
        if (activePanel) {
            activePanel.classList.add('active');
        }
    }) as EventListener);
</script>
