---
import Layout from '@layouts/Layout.astro';

interface Props {
    title: string;
    description?: string;
    /** URL of the page's markdown twin, advertised to LLMs/crawlers. */
    markdownUrl?: string;
}

const { title, description, markdownUrl } = Astro.props as Props;
---

<Layout
    title={title}
    description={description}
    markdownUrl={markdownUrl}
    showSearchBar={true}
    showDocsNav={false}
    hideFooter={true}
>
    <slot />
</Layout>
