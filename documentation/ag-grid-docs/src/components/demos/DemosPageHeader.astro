---
import { Icon } from '@ag-website-shared/components/icon/Icon';
import type { DemoPageContent } from '@components/demos/demoContent';
import { VIDEO_TOUR_TEXT, VIDEO_TOUR_URL } from '@components/demos/demosData';
import styles from '@pages-styles/example.module.scss';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';

import DemoTabs from './DemosTabs.astro';

interface Props {
    content: DemoPageContent;
}

// Every demo page renders the same H1, links and intro above its grid, so the markup lives here
// rather than being repeated four times. The copy comes from the demo's frontmatter contract.
const { content } = Astro.props as Props;
---

<div class={styles.topHeader}>
    <div>
        <div class={styles.headerTitle}>
            <h1 class={styles.headerHeading}>{content.seoH1}</h1>
            <a class="button-secondary" target="_blank" rel="noopener noreferrer" href={content.githubUrl}>
                <Icon name="github" svgClasses={styles.githubIcon} />
                <span>See On GitHub</span>
            </a>
            <a class="button-secondary" href={VIDEO_TOUR_URL} target="_blank" rel="noopener noreferrer">
                <Icon alt={`Youtube logo`} name="youtube" svgClasses={styles.youtubeIcon} />
                <span>{VIDEO_TOUR_TEXT}</span>
            </a>
            <a class="button-secondary" href={urlWithBaseUrl('/contact/')}>
                <span>Contact Us</span>
            </a>
        </div>
        <p class={styles.intro}>{content.intro}</p>
    </div>

    <DemoTabs activeTab={content.activeTab} />
</div>
