---
import { getPageImages } from '@components/docs/utils/filesData';
import { getPageNameFromPath } from '@components/docs/utils/urlPaths';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';

import styles from './Gif.module.scss';

interface Props {
    pageName?: string;
    imagePath: string;
    alt: string;
    autoPlay?: boolean;
    wrapped?: boolean;
}

const { pageName: propPageName, imagePath, alt, autoPlay, wrapped } = Astro.props as Props;

const pageName = propPageName ? propPageName : getPageNameFromPath(Astro.url.pathname);

const { imageSrc, darkModeImageSrc, gifStillImageSrc, gifDarkModeStillImageSrc } = await getPageImages({
    pageName,
    imagePath,
});
---

{
    /* A player for GIFs: the still first frame loads with the page and a play button is shown over
    it, and only a click loads and plays the (much larger) GIF itself.

    The four sources are handed to gif-player.js as data-attributes, and it picks between them
    before the first paint. The `src` here is a light one either way, so that the image still
    resolves without JavaScript: it is already correct on a light page, and on a dark one the
    script replaces it in the same task this markup is parsed in, before anything is painted. */
}
<div class={styles.gifPlayer} data-gif-player data-playing={autoPlay ? '' : undefined}>
    <img
        class:list={[styles.gif, { [styles.wrapped]: wrapped }]}
        src={autoPlay ? imageSrc : gifStillImageSrc}
        alt={alt}
        data-light-gif={imageSrc}
        data-dark-gif={darkModeImageSrc}
        data-light-still={gifStillImageSrc}
        data-dark-still={gifDarkModeStillImageSrc}
    />
    <div class={styles.playButton}></div>
</div>

<script is:inline src={urlWithBaseUrl('/scripts/gif-player.js')}></script>
