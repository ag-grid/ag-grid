---
import styles from '../../../../pages-styles/framework-landing-page.module.scss';
import InstallText from '@components/install-text/InstallText';
import { Icon } from '@ag-website-shared/components/icon/Icon';
import { Finance } from 'src/components/demos/examples/finance';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';
import { FRAMEWORK_CONFIGS, type FrameworkConfig } from './../types';

interface Props {
    framework: keyof typeof FRAMEWORK_CONFIGS;
    latestVersion?: string;
    landingPageHighlight?: string;
}

const { framework, latestVersion, landingPageHighlight } = Astro.props;
const config: FrameworkConfig = FRAMEWORK_CONFIGS[framework];
---

<div class={styles.heroSection}>
    <div class={styles.blueRectangle}></div>
    <div class={styles.heroSectionInner}>
        <div class={styles.heroSectionContainer}>
            <div class={styles.heroSectionHeadingContainer}>
                <a
                    href={urlWithBaseUrl('./whats-new')}
                    class:list={[
                        styles.heroSectionVersionTagContainer,
                        `plausible-event-name=${config.analyticsPrefix}-whats-new`,
                    ]}
                >
                    <span class={styles.heroSectionVersion}>AG Grid v{latestVersion}</span>
                    <span class={styles.heroSectionFeatureHighlight}>
                        {landingPageHighlight && <span>{landingPageHighlight}</span>}
                        <Icon svgClasses={styles.heroSectionFeatureArrow} name="arrowRight" />
                    </span>
                </a>
                <h1 class={styles.heroSectionTag}>{config.hero.tag}</h1>
                <h2 class={styles.heroSectionHeading}>{config.hero.heading}</h2>
                <h3 class={styles.heroSectionSubHeading}>
                    Add <b>high-performance</b>, <b>feature rich</b>, and <b>fully customisable</b>
                    {config.hero.subHeading}
                    to your application in <b>minutes</b>, all for <b>free</b>.
                </h3>
            </div>
            <div class={styles.heroSectionButtonContainer}>
                <a
                    id="get-started"
                    class:list={[
                        'button-secondary',
                        styles.heroSectionCta1,
                        `plausible-event-name=${config.analyticsPrefix}-get-started`,
                    ]}
                    href={urlWithBaseUrl(`./${config.docsPath}/getting-started/`)}
                >
                    Get Started
                </a>
                <div class={styles.heroSectionCta2}>
                    <InstallText client:load packageName={config.packageName} />
                </div>
            </div>
            <div class={styles.heroSectionDemoContainer}>
                <Finance client:only="react" gridHeight={600} />
            </div>
            <a
                id="view-demos"
                class:list={[
                    'button',
                    styles.heroSectionViewAllDemosLink,
                    `plausible-event-name=${config.analyticsPrefix}-view-demos`,
                ]}
                href={urlWithBaseUrl('./example')}
            >
                View All Demos
                <Icon svgClasses={styles.heroSectionDemosArrow} name="arrowRight" />
            </a>
        </div>
    </div>
</div>
