---
import { MetaData } from './lib/MetaData';
import ExampleStyle from './lib/ExampleStyle.astro';
import Styles from './lib/Styles.astro';
import Extras from './lib/Extras.astro';
import { ExampleModules } from './lib/ExampleModules';
import { Scripts } from './lib/Scripts';
import type { InternalFramework } from '@ag-grid-types';

interface Props {
    isDev: boolean;
    title: string;
    isEnterprise: boolean;
    isIntegratedCharts?: boolean;
    internalFramework: InternalFramework;

    modifiedTimeMs: number;
    entryFileName: string;
    /**
     * Every file the example ships, as authored -- only needed when the page transpiles them itself
     */
    fileNames: string[];
    /**
     * Extra script file names (not including entry file)
     */
    scriptFiles?: string[];
    styleFiles?: string[];
    appLocation: string;
    ignoreModuleLoader?: boolean;
    extraStyles?: string;
    headFragment?: string;
    extras?: string[];
    usesMathRandom?: boolean;
    /**
     * Whether to transpile the example's sources in the page instead of serving them transpiled
     */
    transpileInBrowser?: boolean;
    nonce?: string;
}

const {
    title,
    isDev,
    isEnterprise,
    isIntegratedCharts,
    internalFramework,
    modifiedTimeMs,
    appLocation,
    entryFileName,
    fileNames,
    scriptFiles = [],
    styleFiles = [],
    ignoreModuleLoader,
    extraStyles,
    headFragment,
    extras,
    usesMathRandom,
    transpileInBrowser,
    nonce,
} = Astro.props as Props;
---

<html lang="en">
    <head>
        <MetaData isDev={isDev} title={`React Example - ${title}`} modifiedTimeMs={modifiedTimeMs} />
        <ExampleStyle rootSelector="#root" extraStyles={extraStyles} />
        <Styles baseUrl={appLocation} files={styleFiles} />
        <Extras extras={extras ?? []} />
        <Fragment set:html={headFragment} />
    </head>
    <body>
        <div id="root"></div>

        <script
            is:inline
            nonce={nonce}
            define:vars={{
                appLocation,
            }}
        >
            window.__basePath = appLocation;
        </script>

        {scriptFiles && <Scripts baseUrl={appLocation} files={scriptFiles} nonce={nonce} />}
        {
            !ignoreModuleLoader && (
                <ExampleModules
                    appLocation={appLocation}
                    entryFileName={entryFileName}
                    fileNames={fileNames}
                    internalFramework={internalFramework}
                    isEnterprise={isEnterprise}
                    isIntegratedCharts={isIntegratedCharts}
                    usesMathRandom={usesMathRandom}
                    transpileInBrowser={transpileInBrowser}
                    nonce={nonce}
                />
            )
        }
        <slot />
    </body>
</html>
