---
import { MetaData } from './lib/MetaData';
import ExampleStyle from './lib/ExampleStyle.astro';
import Styles from './lib/Styles.astro';
import Extras from './lib/Extras.astro';
import { ExampleModules } from './lib/ExampleModules';
import { getCacheBustingUrl } from '@utils/gridLibraryPaths';
import { Scripts } from './lib/Scripts';

interface Props {
    isDev: boolean;
    title: string;
    isEnterprise: boolean;
    isIntegratedCharts?: boolean;

    modifiedTimeMs: number;
    entryFileName: string;
    /**
     * Every file the example ships, as authored -- only needed when the page transpiles them itself
     */
    fileNames: string[];

    styleFiles?: string[];
    scriptFiles: string[];
    appLocation: string;
    extraStyles?: string;
    headFragment?: string;
    extras?: string[];
    usesMathRandom?: boolean;
    /**
     * Whether to transpile the example's sources in the page instead of serving them transpiled
     */
    transpileInBrowser?: boolean;
    nonce?: string;
}

const {
    title,
    isDev,
    isEnterprise,
    isIntegratedCharts,
    modifiedTimeMs,
    appLocation,
    entryFileName,
    fileNames,
    styleFiles,
    scriptFiles,
    extraStyles,
    headFragment,
    extras,
    usesMathRandom,
    transpileInBrowser,
    nonce,
} = Astro.props as Props;
---

<html lang="en">
    <head>
        <MetaData isDev={isDev} title={`Angular Example - ${title}`} modifiedTimeMs={modifiedTimeMs} />
        <ExampleStyle rootSelector="my-app" extraStyles={extraStyles} />
        <Styles
            baseUrl={appLocation}
            files={isDev && styleFiles
                ? styleFiles
                      .filter((file: string) => !file.includes('style.css') && !file.includes('styles.css'))
                      .map((file: string) => getCacheBustingUrl(file, modifiedTimeMs))
                : []}
        />
        <Extras extras={extras ?? []} />
        <Fragment set:html={headFragment} />
    </head>
    <body>
        <my-app></my-app>

        <script
            is:inline
            nonce={nonce}
            define:vars={{
                appLocation,
            }}
        >
            window.__basePath = appLocation;
        </script>

        <script is:inline nonce={nonce}>
            document.write('<base href="' + document.location + '" />');
        </script>
        <script is:inline nonce={nonce} src="https://cdn.jsdelivr.net/npm/core-js-bundle@3.6.5/minified.js"></script>
        <script is:inline nonce={nonce} src="https://cdn.jsdelivr.net/npm/zone.js@0.14.3/bundles/zone.umd.min.js"
        ></script>

        {scriptFiles && <Scripts baseUrl={appLocation} files={scriptFiles} nonce={nonce} />}
        <ExampleModules
            appLocation={appLocation}
            entryFileName={entryFileName}
            fileNames={fileNames}
            internalFramework={'angular'}
            isEnterprise={isEnterprise}
            isIntegratedCharts={isIntegratedCharts}
            usesMathRandom={usesMathRandom}
            transpileInBrowser={transpileInBrowser}
            nonce={nonce}
        />
        <Styles
            baseUrl={appLocation}
            files={styleFiles
                ? styleFiles.filter((file: string) => file.includes('style.css') || file.includes('styles.css'))
                : []}
        />
        <slot />
    </body>
</html>
