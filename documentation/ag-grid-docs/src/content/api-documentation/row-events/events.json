{
    "_config_": {
        "codeSrc": "row-node.AUTO.json"
    },
    "rowNodeEvents": {
        "meta": {
            "displayName": "Row Events",
            "isEvent": true
        },
        "rowSelected": {
            "description": "Row was selected or unselected.",
            "type": {
                "arguments": {
                    "event": "RowNodeSelectedEvent"
                },
                "returnType": "void"
            }
        },
        "selectableChanged": {
            "description": "Row selectable value has changed.",
            "type": {
                "arguments": {
                    "event": "SelectableChangedEvent"
                },
                "returnType": "void"
            }
        },
        "displayedChanged": {
            "description": "Row is now, or is no longer, displayed.",
            "type": {
                "arguments": {
                    "event": "DisplayedChangedEvent"
                },
                "returnType": "void"
            }
        },
        "mouseEnter": {
            "description": "Mouse has entered the row.",
            "type": {
                "arguments": {
                    "event": "MouseEnterEvent"
                },
                "returnType": "void"
            }
        },
        "mouseLeave": {
            "description": "Mouse has left the row.",
            "type": {
                "arguments": {
                    "event": "MouseLeaveEvent"
                },
                "returnType": "void"
            }
        },
        "cellChanged": {
            "description": "One cell value has changed.",
            "type": {
                "arguments": {
                    "event": "CellChangedEvent"
                },
                "returnType": "void"
            }
        },
        "dataChanged": {
            "description": "`rowData` has changed.",
            "type": {
                "arguments": {
                    "event": "DataChangedEvent"
                },
                "returnType": "void"
            }
        },
        "masterChanged": {
            "description": "Row `master` value has changed.",
            "type": {
                "arguments": {
                    "event": "MasterChangedEvent"
                },
                "returnType": "void"
            }
        },
        "heightChanged": {
            "description": "`rowHeight` has changed.",
            "type": {
                "arguments": {
                    "event": "HeightChangedEvent"
                },
                "returnType": "void"
            }
        },
        "rowIndexChanged": {
            "description": "`rowIndex` has changed.",
            "type": {
                "arguments": {
                    "event": "RowIndexChangedEvent"
                },
                "returnType": "void"
            }
        },
        "topChanged": {
            "description": "`rowTop` has changed.",
            "type": {
                "arguments": {
                    "event": "TopChangedEvent"
                },
                "returnType": "void"
            }
        },
        "groupChanged": {
            "description": "Row `group` value has changed.",
            "type": {
                "arguments": {
                    "event": "GroupChangedEvent"
                },
                "returnType": "void"
            }
        },
        "expandedChanged": {
            "description": "`expanded` has changed.",
            "type": {
                "arguments": {
                    "event": "ExpandedChangedEvent"
                },
                "returnType": "void"
            }
        },
        "hasChildrenChanged": {
            "description": "Row `hasChildren` value has changed.",
            "type": {
                "arguments": {
                    "event": "HasChildrenChangedEvent"
                },
                "returnType": "void"
            }
        },
        "allChildrenCountChanged": {
            "description": "`allChildrenCount` has changed.",
            "type": {
                "arguments": {
                    "event": "AllChildrenCountChangedEvent"
                },
                "returnType": "void"
            }
        },
        "uiLevelChanged": {
            "description": "`uiLevel` has changed.",
            "type": {
                "arguments": {
                    "event": "UiLevelChangedEvent"
                },
                "returnType": "void"
            }
        },
        "rowPinned": {
            "description": "Row has been pinned to the top or bottom by the user",
            "type": {
                "arguments": {
                    "event": "RowNodePinnedEvent"
                },
                "returnType": "void"
            }
        },
        "rowHighlightChanged": {
            "description": "Row highlight value has changed (e.g. during drag and drop).",
            "type": {
                "arguments": {
                    "event": "RowHighlightChangedEvent"
                },
                "returnType": "void"
            }
        },
        "draggingChanged": {
            "description": "Row `dragging` value has changed.",
            "type": {
                "arguments": {
                    "event": "DraggingChangedEvent"
                },
                "returnType": "void"
            }
        }
    }
}
