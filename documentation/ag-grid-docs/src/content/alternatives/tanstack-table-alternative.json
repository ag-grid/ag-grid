    "whySwitch": {
        "heading": "Why teams look for a TanStack Table alternative",
        "reasons": [
            "TanStack Table is headless, so the developer writes all the table markup and CSS.",
            "Virtualisation needs the separate TanStack Virtual package, and cell editing is not in its core.",
            "Its built-in features do not include pivoting, CSV or Excel export, or charts."
        ]
    },
    "whyProduct": [
        {
            "title": "One grid for every framework",
            "body": "Official packages for React, Angular and Vue, plus plain JavaScript, with the same grid features in each."
        },
        {
            "title": "Large datasets in the free version",
            "body": "Row and column virtualisation are on by default in AG Grid Community, and the Infinite Row Model loads data from the server as users scroll."
        },
        {
            "title": "Analysis built into the grid",
            "body": "AG Grid Enterprise adds row grouping, aggregation, pivoting, master/detail, Excel export and integrated charts to the same component."
        },
        {
            "title": "Clear licensing",
            "body": "AG Grid Community is MIT licensed. AG Grid Enterprise is a perpetual licence with one year of updates and support."
        }
