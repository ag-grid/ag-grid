    "faq": [
        {
            "question": "What is the difference between AG Grid and TanStack Table?",
            "answer": "AG Grid renders a complete grid UI with built-in virtualisation, editing and export. TanStack Table is headless: it provides the table logic and you write the markup and CSS."
        },
        {
            "question": "Is AG Grid free like TanStack Table?",
            "answer": "AG Grid Community is free under the MIT licence, as TanStack Table is. AG Grid Enterprise is a paid licence for features such as pivoting, Excel export and integrated charts."
        },
        {
            "question": "How much does an AG Grid licence cost?",
            "answer": "AG Grid Community is free. AG Grid Enterprise, and the Enterprise Bundle with AG Charts Enterprise, are paid perpetual licences that include one year of updates and support. See [AG Grid pricing](/license-pricing/) for prices."
        }
