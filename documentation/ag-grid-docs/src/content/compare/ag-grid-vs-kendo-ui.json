    "faq": [
        {
            "question": "What is a Kendo grid?",
            "answer": "Kendo UI Grid is a data grid component from Progress Telerik. It is sold as separate libraries for React (KendoReact), Angular, Vue and jQuery."
        },
        {
            "question": "Is Kendo grid free?",
            "answer": "The React version has a free tier, KendoReact Free, with a reduced set of Grid features. Kendo UI for Angular, Vue and jQuery need a paid licence."
        },
        {
            "question": "Does AG Grid work with Angular?",
            "answer": "Yes. AG Grid has official packages for Angular, React and Vue, and can be used with plain JavaScript."
        },
        {
            "question": "Can I use AG Grid for free?",
            "answer": "Yes. AG Grid Community is free and open source under the MIT licence, including for commercial use. AG Grid Enterprise is a paid licence that adds features such as row grouping, pivoting, Excel export and the Server-Side Row Model."
        },
        {
            "question": "Does AG Grid include pivoting and tree data?",
            "answer": "Yes. AG Grid Enterprise includes pivoting and tree data in the grid itself. Kendo provides them as separate components, PivotGrid and TreeList."
        }
    ],
