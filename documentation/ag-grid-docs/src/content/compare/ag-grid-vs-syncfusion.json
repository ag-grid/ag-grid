    "hero": {
        "heading": "AG Grid vs Syncfusion",
        "subHeading": "How AG Grid and Syncfusion Data Grid compare on framework support, free and paid features, large datasets, pricing and licensing."
    },
    "shortAnswer": "AG Grid Community is free under the MIT licence for organisations of any size. Syncfusion Data Grid is commercial software: its free Community License is limited to organisations with under $1M annual revenue, 5 or fewer developers and 10 or fewer employees, and other organisations need a paid licence such as the Grid SDK, an annual subscription at $959 per developer per year. Both support React, Angular, Vue and plain JavaScript, and Syncfusion also covers Blazor and other .NET platforms. In Syncfusion, pivoting and tree data are separate Pivot Table and Tree Grid components; in AG Grid they are features of the grid itself, in [AG Grid Enterprise](/license-pricing/).",
    "keyFigures": [
        {
            "value": "MIT",
            "label": "AG Grid Community licence",
            "detail": "Free for organisations of any size, with no revenue or headcount limits."
        },
        {
            "value": "$959",
            "label": "Syncfusion Grid SDK, per developer per year",
            "detail": "An annual subscription, for organisations outside the Community License limits."
        },
        {
            "value": "$1M",
            "label": "Syncfusion Community License revenue limit",
            "detail": "Also limited to 5 or fewer developers, 10 or fewer employees and no more than $3M in outside capital."
        }
    ],
