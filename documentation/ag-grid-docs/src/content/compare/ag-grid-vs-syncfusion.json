    "faq": [
        {
            "question": "How much does Syncfusion cost?",
            "answer": "The Syncfusion Grid SDK is $959 per developer per year, and the UI Component Suite, which includes all seven of Syncfusion's standalone UI SDKs, is $1,199 per developer per year. Both are annual subscriptions with a minimum term of one year and include Business Support. Organisations that meet the Community License limits can apply for a free licence."
        },
        {
            "question": "Is Syncfusion UI free?",
            "answer": "Only for organisations that qualify for the Syncfusion Community License: under $1M annual gross revenue, 5 or fewer developers, 10 or fewer employees and never more than $3M in outside capital. Government bodies funded by taxes are not eligible. AG Grid Community is free under the MIT licence for any organisation."
        },
        {
            "question": "What is Syncfusion used for?",
            "answer": "Syncfusion sells UI component libraries for web, desktop and mobile applications, including a data grid, charts, a scheduler and document-processing SDKs."
        },
        {
            "question": "Does Syncfusion work with Angular?",
            "answer": "Yes. Syncfusion Data Grid is available for Angular, React, Vue and JavaScript. AG Grid also supports all four."
        },
        {
            "question": "What is AG Grid used for?",
            "answer": "AG Grid is a JavaScript data grid for displaying, editing and analysing tabular data in web applications built with React, Angular, Vue or plain JavaScript. Its features include sorting, filtering, cell editing and virtualisation for large datasets and, in Enterprise, row grouping, pivoting, Excel export and integrated charts."
        },
        {
            "question": "Can I use AG Grid for free?",
            "answer": "Yes. AG Grid Community is free and open source under the MIT licence, including for commercial use. AG Grid Enterprise is a paid licence that adds features such as row grouping, pivoting, Excel export and the Server-Side Row Model. See [Community vs Enterprise](./community-vs-enterprise/)."
        },
        {
            "question": "How much does an AG Grid licence cost?",
            "answer": "AG Grid Community is free. AG Grid Enterprise, and the Enterprise Bundle with AG Charts Enterprise, are perpetual licences priced per developer, with one year of updates and support. [Configure your licence](/license-pricing/) to see your price."
        }
    ],
