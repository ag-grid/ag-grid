            "label": "AG Grid Community licence",
            "detail": "Free for commercial use. Handsontable's free licence is for non-commercial use and evaluation."
        },
        {
            "value": "3",
            "label": "AG Grid features Handsontable does not include",
            "detail": "Pivoting, integrated charts and row grouping by column."
        },
        {
            "value": "~400",
            "label": "Handsontable formula functions",
            "detail": "Through the HyperFormula engine, which is licensed separately."
        }
