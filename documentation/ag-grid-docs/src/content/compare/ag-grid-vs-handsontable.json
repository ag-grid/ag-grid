    "faq": [
        {
            "question": "Is Handsontable free to use?",
            "answer": "Handsontable has a free licence key for non-commercial use, such as research, private study and evaluation. Commercial production use needs a paid licence."
        },
        {
            "question": "Does Handsontable support pivot tables?",
            "answer": "Handsontable's documentation does not list a pivot table feature. AG Grid includes pivoting in AG Grid Enterprise."
        },
        {
            "question": "Is AG Grid free for commercial use?",
            "answer": "Yes. AG Grid Community is released under the MIT licence, which allows commercial use. AG Grid Enterprise is a paid licence for the advanced features."
        },
        {
            "question": "Does AG Grid support spreadsheet-style formulas?",
            "answer": "Yes. AG Grid Enterprise includes formulas: users enter spreadsheet-style expressions in cells, and the values update when the data they reference changes. Handsontable provides formulas through HyperFormula, which is licensed and installed separately."
        },
        {
            "question": "What is AG Grid used for?",
            "answer": "AG Grid is a JavaScript data grid for displaying, editing and analysing tabular data in web applications built with React, Angular, Vue or plain JavaScript. Its features include sorting, filtering, cell editing, virtualisation for large datasets and, in Enterprise, row grouping, pivoting, Excel export and integrated charts."
        }
    ],
