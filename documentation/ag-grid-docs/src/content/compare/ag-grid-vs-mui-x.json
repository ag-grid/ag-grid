    "hero": {
        "heading": "AG Grid vs MUI X",
        "subHeading": "How AG Grid and MUI X Data Grid compare on framework support, free and paid features, large datasets, pricing and licensing."
    },
    "shortAnswer": "AG Grid and MUI X Data Grid (the MUI DataGrid) both render a complete grid UI, and both have a free, MIT-licensed version and paid plans. AG Grid works with React, Angular, Vue and plain JavaScript; MUI X Data Grid is built for React only and needs Material UI as a peer dependency. AG Grid Community includes row virtualisation, column pinning and multi-column sorting. In the free MUI X Data Grid, row virtualisation is limited to 100 rows, and column pinning and multi-column sorting need the paid Pro plan. Row grouping, aggregation, pivoting and Excel export are paid in both: in [AG Grid Enterprise](/license-pricing/), a perpetual licence, and in MUI X Premium, at $599 per developer per year or $1,318 per developer for a perpetual licence.",
    "keyFigures": [
        {
            "value": "4 vs 1",
            "label": "Frameworks supported",
            "detail": "AG Grid: React, Angular, Vue and plain JavaScript. MUI X Data Grid: React only."
        },
        {
            "value": "100",
            "label": "Row virtualisation limit in the free MUI X Data Grid",
            "detail": "Beyond that it is a Pro plan feature. AG Grid Community virtualises rows by default."
        },
        {
            "value": "Premium",
            "label": "MUI X plan for row grouping, pivoting and Excel export",
            "detail": "$599 per developer per year, or $1,318 per developer for a perpetual licence."
        }
    ],
