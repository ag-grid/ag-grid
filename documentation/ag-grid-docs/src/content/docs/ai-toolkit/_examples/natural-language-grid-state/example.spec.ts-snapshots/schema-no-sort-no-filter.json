{
  "type": "object",
  "required": [
    "columnVisibility",
    "columnSizing",
    "sideBar",
    "focusedCell",
    "rowGroupExpansion"
  ],
  "additionalProperties": false,
  "properties": {
    "columnVisibility": {
      "type": [
        "object",
        "null"
      ],
      "description": "Column visibility configuration for the grid",
      "required": [
        "hiddenColIds"
      ],
      "additionalProperties": false,
      "properties": {
        "hiddenColIds": {
          "type": "array",
          "description": "Array of column IDs to hide",
          "items": {
            "$ref": "#/$defs/allColumnIds"
          }
        }
      }
    },
    "columnSizing": {
      "type": [
        "object",
        "null"
      ],
      "description": "Column sizing configuration for the grid",
      "required": [
        "columnSizingModel"
      ],
      "additionalProperties": false,
      "properties": {
        "columnSizingModel": {
          "type": "array",
          "description": "Array of column sizing configurations",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "colId",
                  "width"
                ],
                "additionalProperties": false,
                "properties": {
                  "colId": {
                    "$ref": "#/$defs/resizableColumnId"
                  },
                  "width": {
                    "type": "number",
                    "description": "Fixed width in pixels",
                    "minimum": 20
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "colId",
                  "flex"
                ],
                "additionalProperties": false,
                "properties": {
                  "colId": {
                    "$ref": "#/$defs/resizableColumnId"
                  },
                  "flex": {
                    "type": "number",
                    "description": "Flex sizing ratio",
                    "minimum": 0
                  }
                }
              }
            ]
          }
        }
      }
    },
    "sideBar": {
      "type": [
        "object",
        "null"
      ],
      "description": "Side bar configuration for the grid",
      "required": [
        "visible",
        "position",
        "openToolPanel"
      ],
      "additionalProperties": false,
      "properties": {
        "visible": {
          "type": "boolean",
          "description": "Whether the side bar is shown"
        },
        "position": {
          "type": "string",
          "description": "Which side of the grid the side bar is docked to",
          "enum": [
            "left",
            "right"
          ]
        },
        "openToolPanel": {
          "type": [
            "string",
            "null"
          ],
          "description": "ID of the tool panel to open, or null to close the open panel",
          "enum": [
            "columns",
            "filters-new"
          ]
        }
      }
    },
    "focusedCell": {
      "type": [
        "object",
        "null"
      ],
      "description": "Focused cell for the grid",
      "required": [
        "colId",
        "rowIndex",
        "rowPinned"
      ],
      "additionalProperties": false,
      "properties": {
        "colId": {
          "$ref": "#/$defs/allColumnIds"
        },
        "rowIndex": {
          "type": "number",
          "description": "Zero-based index of the row to focus",
          "minimum": 0
        },
        "rowPinned": {
          "type": [
            "string",
            "null"
          ],
          "description": "Pinned row container holding the row, or null for a regular row",
          "enum": [
            "top",
            "bottom"
          ]
        }
      }
    },
    "rowGroupExpansion": {
      "type": [
        "object",
        "null"
      ],
      "description": "Expanded row groups for the grid. Omit a group to collapse it.",
      "required": [
        "expandedRowGroupIds"
      ],
      "additionalProperties": false,
      "properties": {
        "expandedRowGroupIds": {
          "type": "array",
          "description": "Row IDs of the groups to expand",
          "items": {
            "type": "string",
            "description": "Row ID of a group row"
          }
        }
      }
    }
  },
  "$defs": {
    "allColumnIds": {
      "_defs": {},
      "_nullable": false,
      "description": "athlete\ncountry",
      "_enum": [
        "athlete",
        "country"
      ],
      "type": "string"
    },
    "resizableColumnId": {
      "_defs": {},
      "_nullable": false,
      "description": "Column ID that supports resizing",
      "_enum": [
        "athlete",
        "country"
      ],
      "type": "string"
    }
  }
}