    "hero": {
        "heading": "Looking for an AG Grid alternative?",
        "subHeading": "Before you choose an AG Grid alternative, check what your table needs. A lighter library can be enough for a simple table, and AG Grid Community is free under the MIT licence, with Enterprise only for advanced features."
    },
    "lighterOption": {
        "heading": "When a lighter library is enough",
        "reasons": [
            "Your table shows a small set of rows that users only read, so a plain HTML table styled to match your app does the job.",
            "Sorting and pagination are all users need, with no editing, filtering or export.",
            "You want to own every element of the markup, and are happy to build the table's interface yourself on a headless table library.",
            "You are adding one simple table to a page where a small JavaScript bundle matters more than grid features."
        ]
    },
    "whyProduct": [
        {
            "title": "Large datasets in the free version",
            "body": "Row and column virtualisation are on by default in AG Grid Community, and the Infinite Row Model loads data from the server as users scroll."
        },
        {
            "title": "Filtering, editing and export built in",
            "body": "AG Grid Community includes text, number and date filters, a quick filter, cell editors, row selection and CSV export, so you do not build them yourself."
        },
        {
            "title": "One grid for every framework",
            "body": "Official packages for React, Angular and Vue, plus plain JavaScript, with the same grid features in each."
        },
        {
            "title": "Room to grow",
            "body": "When you need row grouping, pivoting, set filters or Excel export, add AG Grid Enterprise to the grid you already have: install the ag-grid-enterprise package and register the modules you need."
        }
    ],
