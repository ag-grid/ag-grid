        {
            "id": "",
            "type": "tiers",
            "eyebrow": "Tiers",
            "heading": "Choose the Scheduler Tier That Fits",
            "body_text": "Bryntum Scheduler comes in three tiers that share one API, so you can start free and move up as your application grows.",
            "items": [
                {
                    "heading": "Community",
                    "licence": "Free, MIT licence",
                    "features": [
                        "Horizontal and vertical timelines",
                        "Drag-and-drop event editing",
                        "Event editor",
                        "Dependency lines",
                        "Context menus and tooltips",
                        "Backend sync with CrudManager"
                    ]
                },
                {
                    "heading": "{{tier.core}}",
                    "licence": "Commercial licence",
                    "features": [
                        "Recurring events and time zone support",
                        "Dependency editing",
                        "Resource time ranges and non-working time",
                        "Event filtering, copy and paste",
                        "Zoom and pan tools",
                        "Undo and redo",
                        "Lazy loading"
                    ]
                },
                {
                    "heading": "Enterprise",
                    "licence": "Commercial licence",
                    "features": [
                        "Scheduling engine with working-time calendars, constraints, effort-driven scheduling and dependency types",
                        "Resource and timeline histograms, utilisation views",
                        "Nested events and event segments",
                        "Summaries",
                        "PDF export and print",
                        "AI features",
                        "Salesforce support"
                    ]
                }
            ],
            "ctas": [
                {
                    "text": "Compare tiers",
                    "href": "/products/scheduler/features",
                    "title": "Compare Scheduler tiers"
                }
            ]
        },
