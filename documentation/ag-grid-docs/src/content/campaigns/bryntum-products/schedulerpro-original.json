        {
            "id": "block_568e2c365c073264165eb83fbaa79716",
            "type": "text-media",
            "modifiers": ["image", "added-shadow"],
            "heading": "Style It Your Way",
            "body_html": "<p class=\"p1\">Make the scheduler match your brand with flexible styling options.</p> <ul> <li class=\"p1\">Easily modify our built-in themes using CSS variables.</li> <li class=\"p1\">Create your own custom theme.</li> <li class=\"p1\">Choose from preconfigured taskbar styles and color sets.</li> </ul>",
            "body_text": "Make the scheduler match your brand with flexible styling options. Easily modify our built-in themes using CSS variables. Create your own custom theme. Choose from preconfigured taskbar styles and color sets.",
