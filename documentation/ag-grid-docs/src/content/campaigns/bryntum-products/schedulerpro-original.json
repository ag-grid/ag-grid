    "sections": [
        {
            "id": "block_67e17f6b1228d9d75851bddbf1df0ace",
            "type": "heroTBM",
            "modifiers": ["animated-hero"],
            "eyebrow": "Bryntum Scheduler Pro",
            "heading": "A Professional Scheduling Component",
            "body_html": "<p class=\"p1\">Bryntum Scheduler Pro is a JavaScript UI component that helps you plan with precision by accounting for resource availability, dependencies, and constraints.</p>",
            "body_text": "Bryntum Scheduler Pro is a JavaScript UI component that helps you plan with precision by accounting for resource availability, dependencies, and constraints.",
