        {
            "id": "block_e81c12ec56ed0ff49bce53b58de2f4c3",
            "type": "text-media",
            "modifiers": ["image", "reverse", "added-shadow"],
            "heading": "50+ More Widgets",
            "body_html": "<p class=\"p1\">Choose from a <a href=\"/products/scheduler/examples/kitchen-sink/\">wide range of UI elements</a> that easily make your app polished and professional:</p> <ul class=\"ul1\"> <li class=\"li1\">Add <strong>buttons, menus, toggles, charts, and more </strong>to the Bryntum Scheduler Pro.</li> <li class=\"li1\">Meet user needs with fewer clicks and less searching.</li> <li class=\"li1\">Implement widgets easily with our clear documentation.</li> </ul>",
            "body_text": "Choose from a wide range of UI elements that easily make your app polished and professional: Add buttons, menus, toggles, charts, and more to the Bryntum Scheduler Pro. Meet user needs with fewer clicks and less searching. Implement widgets easily with our clear documentation.",
            "links": [
