                    "src": "../assets/calendar/more-widgets-calendar-scaled.png",
                    "alt": "Assorted Bryntum widgets including a date range picker, colour picker, multi-select filter, tags, line chart, button groups, slider and tabs",
                    "width": "1240",
                    "height": "732",
                    "src_original": "https://bryntum.com/wp-content/uploads/2022/05/more-widgets-calendar-scaled.png"
