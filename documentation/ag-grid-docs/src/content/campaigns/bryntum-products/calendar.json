        {
            "id": "block_a19229e400d243cafae6308f92930552",
            "type": "text-media",
            "modifiers": ["image", "reverse", "added-shadow"],
            "eyebrow": "Component Library",
            "heading": "50+ Additional Widgets",
            "body_html": "<p class=\"p1\">Pick from a <a href=\"/products/calendar/examples/kitchen-sink/\">broad set of UI components</a> that quickly give your app a polished, professional feel:</p> <ul class=\"ul1\"> <li class=\"li1\">Drop in ready-made <strong>menus, toggles, sliders, charts and more</strong> alongside the Bryntum Calendar.</li> <li class=\"li1\">Collect input with date range pickers, colour pickers, multi-select combos and checkboxes.</li> <li class=\"li1\">Present data with tabs, button groups, tags and line charts.</li> </ul> <p>Charts come with Calendar Enterprise.</p>",
            "body_text": "Pick from a broad set of UI components that quickly give your app a polished, professional feel: Drop in ready-made menus, toggles, sliders, charts and more alongside the Bryntum Calendar. Collect input with date range pickers, colour pickers, multi-select combos and checkboxes. Present data with tabs, button groups, tags and line charts. Charts come with Calendar Enterprise.",
            "links": [
                {
                    "text": "broad set of UI components",
                    "href": "/products/calendar/examples/kitchen-sink/"
                }
            ],
            "ctas": [
