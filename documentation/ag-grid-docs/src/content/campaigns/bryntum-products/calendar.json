        {
            "id": "block_agbryntum_partnership",
            "type": "partnership",
            "heading": "Your JavaScript stack just expanded",
            "body_html": "<p>Since our 2025 <a href=\"https://www.ag-grid.com/blog/ag-grid-and-bryntum-join-forces-to-strengthen-developer-tooling-for-modern-web-applications/\">partnership with Bryntum</a>, Bryntum Calendar sits alongside AG Grid for event-driven calendar UIs, built by a team held to the same engineering bar.</p>",
            "body_text": "Since our 2025 partnership with Bryntum, Bryntum Calendar sits alongside AG Grid for event-driven calendar UIs, built by a team held to the same engineering bar.",
            "logo_light_src": "/images/campaigns/bryntum-products/shared/ag-grid-x-bryntum-light.svg",
            "logo_dark_src": "/images/campaigns/bryntum-products/shared/ag-grid-x-bryntum-dark.svg",
            "logo_alt": "AG Grid x Bryntum partnership"
        },
