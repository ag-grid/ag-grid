                }
            ]
        },
        {
            "id": "block_7f8a8ef5340328b7601457cdd648ee6d",
            "type": "text-mini-demo",
            "eyebrow": "Try It Live",
            "heading": "Try the live Calendar",
            "body_html": "<p>From the {{tier.core}} tier up, the calendar handles recurring events. Repeat events on any cadence you need – daily, weekly, monthly or yearly.</p>",
            "body_text": "Try the live Calendar  From the {{tier.core}} tier up, the calendar handles recurring events. Repeat events on any cadence you need – daily, weekly, monthly or yearly.",
            "ctas": [],
            "demo_kind": "calendar",
            "demo_position": "right"
        },
        {
            "id": "block_aa0b0e20cb1c4626408c493f793c1527",
            "type": "text-media",
            "modifiers": ["image", "reverse", "added-shadow"],
            "eyebrow": "More Than Events on a Calendar",
            "heading": "A Calendar Built for Serious Planning",
            "body_html": "<p class=\"p1\">The Bryntum Calendar packs distinctive features that boost your team’s productivity:</p> <ul class=\"ul1\"> <li class=\"li1\"><a href=\"/products/calendar/examples/travel-time/\">Show travel time</a> for grounded, real-world planning.</li> <li class=\"li1\">Monitor workload via the <a href=\"/products/calendar/examples/resource-time-capacity/\">capacity tick renderer</a>.</li> <li>Jump between <a href=\"/products/calendar/examples/resource-modes/\">linked resource calendars</a>.</li> </ul> <p>Travel time and the resource capacity view come with Calendar Enterprise.</p>",
            "body_text": "The Bryntum Calendar packs distinctive features that boost your team’s productivity: Show travel time for grounded, real-world planning. Monitor workload via the capacity tick renderer . Jump between linked resource calendars . Travel time and the resource capacity view come with Calendar Enterprise.",
            "links": [
                {
                    "text": "Show travel time",
                    "href": "/products/calendar/examples/travel-time/"
                },
                {
                    "text": "capacity tick renderer",
                    "href": "/products/calendar/examples/resource-time-capacity/"
                },
                {
                    "text": "linked resource calendars",
                    "href": "/products/calendar/examples/resource-modes/"
                }
            ],
            "ctas": [
                {
                    "text": "Open demo",
                    "href": "/products/calendar/examples/travel-time/",
                    "title": "Open demo"
                }
            ],
            "media": [
                {
                    "kind": "image",
                    "src": "../assets/calendar/calendar-travel-time-svalbard-scaled.png",
                    "alt": "Calendar week view with travel time markers between events and an event popup showing a map, address and travel times",
                    "width": "1240",
                    "height": "761",
                    "src_original": "https://bryntum.com/wp-content/uploads/2022/05/calendar-travel-time-svalbard-scaled.png"
                }
