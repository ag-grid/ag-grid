        {
            "id": "block_20bf74698f4e9c691fa32da9577b475a",
            "type": "text-media",
            "modifiers": [
                "image",
                "reverse",
                "added-shadow"
            ],
            "heading": "Powerful and Flexible",
            "body_html": "<p class=\"p1\">Built using JavaScript (ES6+), the Bryntum Calendar runs efficiently and integrates easily. Benefit from:</p> <ul> <li>Fast performance, even with <a href=\"/products/calendar/examples/megadataset/\">massive data sets</a>.</li> <li>Convenient exports to <a href=\"/products/calendar/examples/exporttoexcel/\">Excel</a>, <a href=\"/products/calendar/examples/exporttoics/\">ICS</a>, and <a href=\"/products/calendar/examples/print/\">print</a> formats.</li> <li>Configurable date and time settings, allowing you to <a href=\"/products/calendar/examples/shifted/\">start days at 6 PM</a> or divide time into six-minute <a href=\"/products/calendar/examples/day-time-ticks/\">intervals</a>.</li> </ul>",
            "body_text": "Built using JavaScript (ES6+), the Bryntum Calendar runs efficiently and integrates easily. Benefit from: Fast performance, even with massive data sets . Convenient exports to Excel , ICS , and print formats. Configurable date and time settings, allowing you to start days at 6 PM or divide time into six-minute intervals .",
            "links": [
                {
                    "text": "massive data sets",
                    "href": "/products/calendar/examples/megadataset/"
                },
                {
                    "text": "Excel",
                    "href": "/products/calendar/examples/exporttoexcel/"
                },
                {
                    "text": "ICS",
                    "href": "/products/calendar/examples/exporttoics/"
                },
                {
                    "text": "print",
                    "href": "/products/calendar/examples/print/"
                },
                {
                    "text": "start days at 6 PM",
                    "href": "/products/calendar/examples/shifted/"
                },
                {
                    "text": "intervals",
                    "href": "/products/calendar/examples/day-time-ticks/"
                }
            ],
            "ctas": [],
