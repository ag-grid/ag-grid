                {
                    "kind": "svg-file", "src": "heroes/calendar.svg"
                }
            ]
        },
        {
            "id": "block_agbryntum_partnership",
            "type": "partnership",
            "heading": "Your JavaScript toolkit just got bigger",
            "body_html": "<p>Following our 2025 <a href=\"https://blog.ag-grid.com/ag-grid-and-bryntum-join-forces-to-strengthen-developer-tooling-for-modern-web-applications/\">partnership with Bryntum</a>, the components you trust for data now sit alongside the best tools for scheduling and project planning.</p><p>You already trust AG Grid for your data, Bryntum Calendar brings that same standard to event-driven calendar UIs — built by the same kind of team, to the same standard.</p>",
            "body_text": "Following our 2025 partnership with Bryntum, the components you trust for data now sit alongside the best tools for scheduling and project planning. You already trust AG Grid for your data, Bryntum Calendar brings that same standard to event-driven calendar UIs — built by the same kind of team, to the same standard.",
            "logo_light_src": "/images/campaigns/bryntum-products/shared/ag-grid-x-bryntum-light.svg",
            "logo_dark_src": "/images/campaigns/bryntum-products/shared/ag-grid-x-bryntum-dark.svg",
            "logo_alt": "AG Grid x Bryntum partnership"
        },
