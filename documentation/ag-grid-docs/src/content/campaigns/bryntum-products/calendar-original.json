        {
            "id": "block_aa0b0e20cb1c4626408c493f793c1527",
            "type": "text-media",
            "modifiers": [
                "image",
                "reverse",
                "added-shadow"
            ],
            "heading": "More Than a Date Picker",
            "body_html": "<p class=\"p1\">The Bryntum Calendar has unique features to support your team’s productivity:</p> <ul class=\"ul1\"> <li class=\"li1\"><a href=\"/products/calendar/examples/travel-time/\">Visualize travel time</a> for real-world planning.</li> <li class=\"li1\">Track workload with the <a href=\"/products/calendar/examples/resource-time-capacity/\">capacity tick renderer</a>.</li> <li>Switch between <a href=\"/products/calendar/examples/resource-modes/\">related resource calendars</a>.</li> </ul>",
            "body_text": "The Bryntum Calendar has unique features to support your team’s productivity: Visualize travel time for real-world planning. Track workload with the capacity tick renderer . Switch between related resource calendars .",
            "links": [
                {
                    "text": "Visualize travel time",
                    "href": "/products/calendar/examples/travel-time/"
                },
                {
                    "text": "capacity tick renderer",
                    "href": "/products/calendar/examples/resource-time-capacity/"
                },
                {
