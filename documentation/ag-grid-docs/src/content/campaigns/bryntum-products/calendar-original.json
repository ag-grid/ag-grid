        {
            "id": "block_43c64c3290d21de094d2e1bf6c8bb680",
            "type": "text-media",
            "modifiers": [
                "image",
                "reverse",
                "added-shadow"
            ],
            "heading": "Resource-First View",
            "body_html": "<p class=\"p1\">Stay on top of your team member’s events at a glance:</p> <ul> <li>Instantly see whose events you’re viewing, <span style=\"font-weight: 400;\">based on</span> friendly avatars in the header.</li> <li>Drag and drop events to quickly reassign them.</li> <li>Enjoy a clear and inviting layout.</li> </ul>",
            "body_text": "Stay on top of your team member’s events at a glance: Instantly see whose events you’re viewing, based on friendly avatars in the header. Drag and drop events to quickly reassign them. Enjoy a clear and inviting layout.",
            "links": [],
            "ctas": [
                {
                    "text": "Try demo",
                    "href": "/products/calendar/examples/date-resource/",
                    "title": "Try demo"
                }
            ],
