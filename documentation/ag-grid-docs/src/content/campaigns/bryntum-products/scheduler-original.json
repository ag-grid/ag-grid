        {
            "id": "block_6fb298a3a638c2c29b8f7fbc5f0fbe4f",
            "type": "text-media",
            "modifiers": ["image", "reverse", "added-shadow"],
            "heading": "Fully Customizable",
            "body_html": "<p>Bryntum Scheduler offers an array of customization options, with an extensive and reactive API for making changes on the fly, allowing you to:</p> <ul> <li>Choose from five preset themes or use a <a href=\"/products/scheduler/examples/custom-theme/\">custom theme</a></li> <li><a href=\"/products/scheduler/examples/custom-event-buttons/\">Style event bars</a></li> <li>Render custom content</li> <li>Customize the <a href=\"/products/scheduler/examples/custom-event-editor/\">event editor</a></li> <li>Add <a href=\"/products/scheduler/examples/schedule-context-advanced/\">hover widgets</a></li> </ul>",
            "body_text": "Bryntum Scheduler offers an array of customization options, with an extensive and reactive API for making changes on the fly, allowing you to: Choose from five preset themes or use a custom theme Style event bars Render custom content Customize the event editor Add hover widgets",
            "links": [
                {
                    "text": "custom theme",
                    "href": "/products/scheduler/examples/custom-theme/"
                },
