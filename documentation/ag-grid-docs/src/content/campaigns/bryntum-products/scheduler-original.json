    "sections": [
        {
            "id": "block_0bc8388be5eda92312da19c25f1d7b70",
            "type": "heroTBM",
            "modifiers": ["animated-hero"],
            "eyebrow": "Bryntum Scheduler",
            "heading": "The Scheduling Component With All the Features",
            "body_html": "<p>Bryntum Scheduler is a modern, high-performance UI component that integrates seamlessly with all JavaScript frameworks, including <a href=\"/products/react-scheduler/\">React</a>, <a href=\"/products/angular-scheduler/\">Angular</a>, and <a href=\"/products/vue-scheduler/\">Vue</a>.</p>",
            "body_text": "Bryntum Scheduler is a modern, high-performance UI component that integrates seamlessly with all JavaScript frameworks, including React , Angular , and Vue .",
            "ctas": [
                {
