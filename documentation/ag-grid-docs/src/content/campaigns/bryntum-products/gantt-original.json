        {
            "id": "block_308bfebd6b6058ced7d49c6b5f4ae83d",
            "type": "text-mini-demo",
            "heading": "The World’s Most Flexible JS Gantt Chart",
            "body_html": "<p class=\"pre-title\">By developers, for developers</p>  <p><span style=\"font-weight: 400;\">A Gantt chart encapsulates an enormous amount of complexity. We provide you with a simple, yet highly configurable and well-tested API, so you don’t have to worry about the small details.</span></p>",
            "body_text": "By developers, for developers  A Gantt chart encapsulates an enormous amount of complexity. We provide you with a simple, yet highly configurable and well-tested API, so you don’t have to worry about the small details.",
            "ctas": [
                {
                    "text": "View API Docs",
                    "href": "/products/gantt/docs/",
                    "title": "View API Docs"
                }
            ],
            "demo_kind": "gantt",
            "demo_position": "right"
        },
        {
            "id": "block_9acd2c85d89f9b4d895ff10ee9aac96e",
            "type": "text-media",
            "modifiers": [
                "video-file",
                "reverse",
                "added-shadow"
            ],
            "heading": "Best-in-Class Scheduling Engine",
            "body_html": "<p><span style=\"font-weight: 400;\">The JavaScript Gantt engine efficiently handles asynchronous scheduling for any number of tasks, while factoring in dependencies, constraints, and scheduling modes.</span></p> <p><span style=\"font-weight: 400;\">Built independently of the DOM, it can also run server-side on Node.js.</span></p> <h6 style=\"margin-top: 1em;\">Animated Redraws</h6> <p><span style=\"font-weight: 400;\">Moving a task triggers a smooth animation that shows how dependent tasks are affected by the change.</span></p>",
            "body_text": "The JavaScript Gantt engine efficiently handles asynchronous scheduling for any number of tasks, while factoring in dependencies, constraints, and scheduling modes. Built independently of the DOM, it can also run server-side on Node.js. Animated Redraws Moving a task triggers a smooth animation that shows how dependent tasks are affected by the change.",
            "links": [],
            "ctas": [],
            "media": [
