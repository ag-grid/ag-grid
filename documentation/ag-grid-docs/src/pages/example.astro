---
import DemosLayout from '@components/demos/DemosLayout.astro';
import DemosPageHeader from '@components/demos/DemosPageHeader.astro';
import Example from '@components/example-grid/Example';
import LogoMark from '@components/logo/LogoMark';
import { DISABLE_MARKDOWN_DOCS } from '@constants';
import styles from '@pages-styles/example.module.scss';
import { demoContent } from '@components/demos/demoContent';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';

// Copy is shared with the /example.md twin so the two cannot drift.
const content = demoContent('performance');
const markdownUrl = DISABLE_MARKDOWN_DOCS ? undefined : urlWithBaseUrl('/example.md');
---

<DemosLayout title={content.seoTitle} description={content.seoDescription} markdownUrl={markdownUrl}>
    <DemosPageHeader content={content} />

    <div class={styles.layout}>
        <div class={styles.layoutWrapper}>
            <div class={styles.loadingLogoContainer}>
                <LogoMark isSpinning />
            </div>
            <Example client:only="react" />
        </div>
    </div>
</DemosLayout>
