---
import DecisionHubPage from '@ag-website-shared/components/decision-pages/DecisionHubPage.astro';
import { sortHubCards } from '@ag-website-shared/components/decision-pages/decisionHub';
import { buildBreadcrumbList } from '@ag-website-shared/utils/structuredData';
import { DISABLE_MARKDOWN_DOCS } from '@constants';
import Layout from '@layouts/Layout.astro';
import { COMPARE_HUB, COMPARE_HUB_NAME, GRID_DECISION_SITE, compareHubCard } from '@utils/decisionPages';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';
import { type CollectionEntry, getCollection, getEntry } from 'astro:content';

const entries = await getCollection('comparePages');
const cards = sortHubCards(entries.map(({ id, data }) => compareHubCard(id, data)));

const { data: metadata } = (await getEntry('metadata', 'metadata')) as CollectionEntry<'metadata'>;
const pageUrl = new URL(Astro.url.pathname, metadata.canonicalUrlBase).href;
const markdownUrl = DISABLE_MARKDOWN_DOCS ? undefined : urlWithBaseUrl('/compare.md');

const pageStructuredData = [
    {
        '@type': 'CollectionPage',
        '@id': pageUrl,
        url: pageUrl,
        name: COMPARE_HUB.title,
        description: COMPARE_HUB.description,
        hasPart: cards.map(({ url }) => ({ '@id': new URL(url, metadata.canonicalUrlBase).href })),
    },
    buildBreadcrumbList({
        pageUrl,
        items: [
            {
                name: GRID_DECISION_SITE.productName,
                url: new URL(GRID_DECISION_SITE.urls.home, metadata.canonicalUrlBase).href,
            },
            { name: COMPARE_HUB_NAME, url: pageUrl },
        ],
    }),
];
---

<Layout
    title={COMPARE_HUB.title}
    description={COMPARE_HUB.description}
    showDocsNav={false}
    showSearchBar={true}
    pageStructuredData={pageStructuredData}
    markdownUrl={markdownUrl}
>
    <DecisionHubPage
        site={GRID_DECISION_SITE}
        heading={COMPARE_HUB.heading}
        subHeading={COMPARE_HUB.subHeading}
        listHeading={COMPARE_HUB.listHeading}
        cards={cards}
        analyticsPrefix="compare-hub"
    />
</Layout>
