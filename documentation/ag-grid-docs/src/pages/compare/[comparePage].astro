---
import ComparisonPage from '@ag-website-shared/components/decision-pages/ComparisonPage.astro';
import { buildDecisionPageStructuredData } from '@ag-website-shared/components/decision-pages/decisionPageStructuredData';
import TechnicalReviewCredit from '@components/technical-review-credit/TechnicalReviewCredit.astro';
import { DISABLE_MARKDOWN_DOCS } from '@constants';
import Layout from '@layouts/Layout.astro';
import { COMPARE_HUB_NAME, GRID_DECISION_SITE, compareRelatedPages } from '@utils/decisionPages';
import { buildTechnicalReviewStructuredData } from '@utils/technicalReviewers';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';
import { type CollectionEntry, getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
    const entries = await getCollection('comparePages');
    const pages = entries.map(({ id, data }) => ({ slug: id, content: data }));
    return pages.map(({ slug, content }) => ({
        params: { comparePage: slug },
        props: { content, related: compareRelatedPages({ slug, pages }) },
    }));
}

type Props = {
    content: CollectionEntry<'comparePages'>['data'];
    related: ReturnType<typeof compareRelatedPages>;
};

const { content, related } = Astro.props;
const { comparePage } = Astro.params;
const markdownUrl = DISABLE_MARKDOWN_DOCS ? undefined : urlWithBaseUrl(`/compare/${comparePage}.md`);
const { data: metadata } = (await getEntry('metadata', 'metadata')) as CollectionEntry<'metadata'>;

// Matches the canonical URL Layout emits, so the WebPage node describes the page being served.
const pageUrl = new URL(Astro.url.pathname, metadata.canonicalUrlBase).href;
const hubUrl = new URL('/compare/', metadata.canonicalUrlBase).href;

const pageStructuredData = [
    ...buildDecisionPageStructuredData({
        canonicalUrlBase: metadata.canonicalUrlBase,
        pageUrl,
        title: content.meta.title,
        description: content.meta.description,
        lastUpdated: content.lastUpdated,
        breadcrumbs: [
            { name: GRID_DECISION_SITE.productName, url: new URL('/', metadata.canonicalUrlBase).href },
            { name: COMPARE_HUB_NAME, url: hubUrl },
            { name: content.hero.heading, url: pageUrl },
        ],
        faq: content.faq,
        competitorName: content.competitor.name,
    }),
    ...(content.technicalReviewer
        ? buildTechnicalReviewStructuredData({ pageUrl, reviewer: content.technicalReviewer })
        : []),
];
---

<Layout
    title={content.meta.title}
    description={content.meta.description}
    showDocsNav={false}
    showSearchBar={true}
    pageStructuredData={pageStructuredData}
    markdownUrl={markdownUrl}
>
    <ComparisonPage content={content} site={GRID_DECISION_SITE} hubName={COMPARE_HUB_NAME} related={related}>
        {content.technicalReviewer && (
            <TechnicalReviewCredit slot="review-credit" reviewer={content.technicalReviewer} />
        )}
    </ComparisonPage>
</Layout>
