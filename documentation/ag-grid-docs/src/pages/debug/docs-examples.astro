---
import { getCollection } from 'astro:content';
import DebugLayout from '@layouts/DebugLayout.astro';
import { getDocsExamplePages } from '@components/docs/utils/pageData';
import { ENABLE_GENERATE_DEBUG_PAGES } from '@constants';
import type { InternalFramework } from '@ag-grid-types';
import { DocsExamples } from '@ag-website-shared/components/docs-examples/components/DocsExamples';

type DocExamplePages = Awaited<ReturnType<typeof getDocsExamplePages>>;
type DocExamplePage = DocExamplePages[number]['params'];
type DocFrameworkExamples = Record<InternalFramework, DocExamplePage>;

const pages = await getCollection('docs');
let examples: DocExamplePages = [];
if (ENABLE_GENERATE_DEBUG_PAGES) {
    examples = await getDocsExamplePages({
        pages,
    });
}

const exampleCollection = examples.reduce(
    (acc, example) => {
        const { internalFramework, pageName, exampleName } = example.params;
        const key = `${pageName}-${exampleName}`;
        if (!acc[key]) {
            acc[key] = {} as DocFrameworkExamples;
        }
        acc[key][internalFramework] = example.params;
        return acc;
    },
    {} as Record<string, DocFrameworkExamples>
);
---

<DebugLayout title={`Debug: Docs Example Pages`}>
    <h1>Docs Example Pages</h1>
    <p>{pages.length} pages, {Object.keys(exampleCollection).length} examples, {examples.length} framework examples</p>
    <DocsExamples exampleCollection={exampleCollection} />
</DebugLayout>
