---
import DemosLayout from '@components/demos/DemosLayout.astro';
import DemosPageHeader from '@components/demos/DemosPageHeader.astro';
import { Inventory } from '@components/demos/examples/inventory';
import LogoMark from '@components/logo/LogoMark';
import styles from '@pages-styles/example.module.scss';
import { demoContent } from '@components/demos/demoContent';

// Copy is shared with the /example-inventory.md twin so the two cannot drift.
const content = demoContent('inventory');
---

<DemosLayout title={content.seoTitle} description={content.seoDescription}>
    <DemosPageHeader content={content} />

    <div class={styles.layout}>
        <div class={styles.layoutWrapper}>
            <div class={styles.loadingLogoContainer}>
                <LogoMark isSpinning />
            </div>
            <Inventory client:only="react" />
        </div>
    </div>
</DemosLayout>
