---
import { getEntry } from 'astro:content';
import { DocsNavFromLocalStorage } from '@ag-website-shared/components/docs-navigation/DocsNavFromLocalStorage';
import { SideNavigation } from '@components/pages-navigation/components/SideNavigation';
import { parseVersion } from '@ag-website-shared/utils/parseVersion';
import Layout from '../layouts/Layout.astro';
import docsStyles from '@ag-website-shared/components/page-styles/docs.module.scss';
import styles from '../pages-styles/legacy-release-notes.module.scss';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';

import type { CollectionEntry } from 'astro:content';

const { data: docsNavData } = (await getEntry('docsNav', 'nav')) as CollectionEntry<'docsNav'>;
const { data: legacyReleaseNotesData } = (await getEntry(
    'legacyReleaseNotes',
    'legacy-release-notes'
)) as CollectionEntry<'legacyReleaseNotes'>;
const { data: versionsData } = (await getEntry('versions', 'ag-grid-versions')) as CollectionEntry<'versions'>;

const legacyReleases = legacyReleaseNotesData
    .map((release) => {
        const version = versionsData.find((version) => release['release version'].includes(version.version));

        const noteSections = [
            release['feature highlights'],
            release['breaking changes'],
            release['deprecations'],
        ].filter((section) => section !== '');

        return {
            version: version?.version,
            date: version?.date,
            noteSections,
        };
    })
    .filter((release) => release.version !== undefined);

const headings = [
    { slug: 'top', depth: 1, text: 'Release Notes' },
    ...legacyReleases
        .filter((release) => parseVersion(release.version).isMajor)
        .map((release) => {
            return {
                slug: `version-${release.version}`,
                depth: 2,
                text: `Version ${parseVersion(release.version).major}`,
            };
        }),
];
---

<Layout
    title={'Legacy Release Notes | AG Grid'}
    description={'Release notes for legacy versions of AG Grid'}
    showDocsNav={true}
    showSearchBar={true}
>
    <div class:list={[docsStyles.contentViewport, 'layout-grid']}>
        <DocsNavFromLocalStorage client:load menuData={docsNavData} pageName={'documentation-archive'} />

        <div id="doc-content" class={docsStyles.docPage}>
            <h1>AG Grid Legacy Release Notes</h1>

            <p class="text-lg">Review release notes for older versions of AG Grid</p>
            <p class="text-lg">
                For full versions references, you can also explore our <a
                    href={urlWithBaseUrl('/documentation-archive')}>documentation archive</a
                >, view our <a href={urlWithBaseUrl('/changelog')}>changelog</a>, or check the our <a
                    href={urlWithBaseUrl('/pipeline')}>build pipeline</a
                >.
            </p>

            <div class={styles.versionsList}>
                {
                    legacyReleases.map((release) => {
                        return (
                            <div class={styles.version}>
                                <h2 id={`version-${release.version}`} class={styles.versionTitle}>
                                    AG Grid v{release.version} <span>- {release.date}</span>
                                </h2>

                                {release.noteSections.map((section) => {
                                    return <div class={styles.versionSection} set:html={section} />;
                                })}
                            </div>
                        );
                    })
                }
            </div>
        </div>

        <SideNavigation client:load headings={headings} delayedScrollSpy={true} />
    </div>
</Layout>
