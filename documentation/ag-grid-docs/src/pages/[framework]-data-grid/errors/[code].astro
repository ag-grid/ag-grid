---
import type { Framework } from '@ag-grid-types';
import Note from '@ag-website-shared/components/alert/Note';
import Warning from '@ag-website-shared/components/alert/Warning';
import { DocsNav } from '@ag-website-shared/components/docs-navigation/DocsNav';
import styles from '@ag-website-shared/components/page-styles/docs.module.scss';
import { DOCS_TAB_ITEM_ID_PREFIX } from '@ag-website-shared/constants';
import { Header } from '@components/docs/components/Header';
import { SideNavigation } from '@components/pages-navigation/components/SideNavigation';
import { FRAMEWORK_REDIRECT_PATH, FRAMEWORKS, PRODUCTION_GRID_SITE_URL } from '@constants';
import Layout from '@layouts/Layout.astro';
import { getIsArchive } from '@utils/env';
import { getFrameworkDisplayText } from '@utils/framework';
import { getErrorTextDetails } from '@utils/getErrorText';
import { getHeadings, getTopHeading } from '@utils/markdoc/getHeadings';
import { getContentRootFileUrl } from '@utils/pages';
import { pathJoin } from '@utils/pathJoin';
import { urlWithPrefix } from '@utils/urlWithPrefix';
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import {
    AG_GRID_ERRORS,
    MAX_ERROR_ID,
    type ErrorId,
} from '../../../../../../packages/ag-grid-community/src/validation/errorMessages/errorText';
import { VERSION } from '../../../../../../packages/ag-grid-community/src/version';

interface Params {
    framework: Framework;
    code: string;
}
interface Props {
    errorPage?: CollectionEntry<'errors'>;
}

export async function getStaticPaths() {
    const errors = await getCollection('errors');
    // The whole allocated range, not just the live codes: a code dropped from `AG_GRID_ERRORS` still needs
    // a page for the client-side hop to its archived copy to run on.
    const codes = Array.from({ length: MAX_ERROR_ID }, (_, index) => index + 1);
    return FRAMEWORKS.flatMap((framework: Framework) => {
        return codes.map((codeNum) => {
            const code = codeNum.toString();
            const errorPage = errors.find(({ id }) => id === code);
            return {
                params: {
                    framework,
                    code,
                },
                props: {
                    errorPage,
                },
            };
        });
    });
}

const { framework, code } = Astro.params as Params;
const { errorPage } = Astro.props as Props;
const errorCode = parseInt(code, 10);
// Covers both a code retired since an earlier release and a number never allocated — the two cannot be
// told apart without a hand-maintained list, so the copy stays version-neutral. It must never reach
// `getErrorText`, which throws for an unknown code under `astro dev` via `throwDevWarning`.
const isUnknownCode = !(errorCode in AG_GRID_ERRORS);
const frameworkDisplayText = framework === 'javascript' ? '' : getFrameworkDisplayText(framework);
const title = `AG Grid ${frameworkDisplayText} Error #${code}`;
const description = errorPage?.data.description ? errorPage?.data.description : '';

const { Content } = errorPage ? await render(errorPage) : { Content: undefined };
const { data: docsNavData } = (await getEntry('docsNav', 'nav')) as CollectionEntry<'docsNav'>;
const { data: allErrorLinks } = (await getEntry('errorLinks', 'links')) as CollectionEntry<'errorLinks'>;

const errorLinks = allErrorLinks.filter((e) => e.errorIds.includes(errorCode)) ?? [];
const path = Astro.url.pathname;
const pageName = `errors/${code}`;
// No query string at build time, so a parameterised error renders with placeholders here and the
// script re-renders it from the URL.
const { text: defaultErrorText, hasPlaceholders } = isUnknownCode
    ? { text: '', hasPlaceholders: false }
    : getErrorTextDetails({ errorCode: errorCode as ErrorId });

const getTabItemSlug = (id: string) => `${DOCS_TAB_ITEM_ID_PREFIX}${id}`;
const topHeading = getTopHeading(title);
const fullErrorTextHeading = { slug: getTabItemSlug('full-error-text'), depth: 2, text: 'Full Error Text' };
const relatedDocPages = { slug: getTabItemSlug('related-doc-pages'), depth: 2, text: 'Related Doc Pages' };
// Error content lives in `content/errors/`, so partials resolve against that rather than `content/docs`.
const errorsContentPath = pathJoin(getContentRootFileUrl().pathname, 'errors');
let headings = errorPage
    ? await getHeadings({
          title,
          pageName,
          partialBasePath: errorsContentPath,
          markdocContent: errorPage.body,
          framework,
          getTabItemSlug,
      })
    : [topHeading, fullErrorTextHeading];

if (errorPage) {
    // insert FullErrorTextHandling in second position as the errorPage brings its own top heading
    headings = [headings[0], fullErrorTextHeading, ...headings.slice(1)];
}

if (errorLinks.length > 0) {
    headings.push(relatedDocPages);
}

const isArchive = getIsArchive();
const migrationUrl = pathJoin(PRODUCTION_GRID_SITE_URL, FRAMEWORK_REDIRECT_PATH, 'migration');
// Without a version to redirect to, the archive index is the one link that helps.
const archiveUrl = pathJoin(PRODUCTION_GRID_SITE_URL, 'documentation-archive');
---

<Layout
    title={title}
    description={description}
    showSearchBar={true}
    showDocsNav={true}
    hidePageFromSearchEngines={true}
>
    <div class:list={[styles.contentViewport, 'layout-grid']}>
        <DocsNav client:load menuData={docsNavData} framework={framework} pageName={pageName} />

        <div id="doc-content" class:list={[styles.docPage, styles.errorPage]}>
            <Header client:load title={title} framework={framework} path={path} menuItems={docsNavData.sections} />

            {
                isArchive && (
                    <Warning>
                        You are using an older version of AG Grid. To upgrade, please see our{' '}
                        <a href={migrationUrl}>migration guides</a>.
                    </Warning>
                )
            }

            <div class={styles.pageSections}>
                <h2 id={fullErrorTextHeading.slug}>{fullErrorTextHeading.text}</h2>
                {
                    isUnknownCode ? (
                        <Warning>
                            Error #{code} is not recognised in AG Grid {VERSION} — it either applies to an older
                            version, or is not an error AG Grid raises. Following the link from your browser's developer
                            console will bring you to the documentation for the version you are running; if you reached
                            this page another way, find your version in the{' '}
                            <a href={archiveUrl}>documentation archive</a>.
                        </Warning>
                    ) : (
                        <>
                            <pre id="errorCodeText">{defaultErrorText}</pre>
                            {hasPlaceholders && (
                                <>
                                    <div id="error-missing-params" hidden>
                                        <Warning>
                                            This URL does not carry the specifics of your error, so the message above
                                            shows placeholders (<code>&lt;name&gt;</code>) in their place. Follow the
                                            full link from your browser's developer console to see the complete message.
                                        </Warning>
                                    </div>
                                    {/* Nothing reveals the warning without JS, so CSS does it there. */}
                                    <noscript>
                                        <style is:inline set:html="#error-missing-params[hidden] { display: block }" />
                                    </noscript>
                                </>
                            )}
                            <Note>
                                To show this error text in the dev console,{' '}
                                <a href={urlWithPrefix({ framework, url: './dev-validation' })}>
                                    enable development validations
                                </a>
                                .
                            </Note>
                        </>
                    )
                }

                {Content ? <Content framework={framework} /> : undefined}

                {
                    errorLinks.length > 0 ? (
                        <>
                            <h2 id={relatedDocPages.slug}>{relatedDocPages.text}</h2>
                            <p>
                                The following documentation pages should provide additional context / guidance on how to
                                resolve this error.
                            </p>
                            <ul>
                                {errorLinks.map((e) => (
                                    <li>
                                        <a href={urlWithPrefix({ framework, url: e.url })}>{e.text}</a>
                                        {e.description ? <span> - {e.description}</span> : undefined}
                                    </li>
                                ))}
                            </ul>
                        </>
                    ) : undefined
                }
            </div>
        </div>

        <SideNavigation client:load headings={headings} />
    </div>
</Layout>

<script>
    import { getErrorTextDetails, formatErrorParamValue } from '@utils/getErrorText';
    import {
        AG_GRID_ERRORS,
        type ErrorId,
    } from '../../../../../../packages/ag-grid-community/src/validation/errorMessages/errorText';
    import { VERSION } from '../../../../../../packages/ag-grid-community/src/version';
    import { getErrorRedirectBaseUrl } from '@utils/getErrorRedirectBaseUrl';
    import { pathJoin } from '@utils/pathJoin';

    const MISSING_PARAMS_ID = 'error-missing-params';
    const ERROR_CODE_TEXT_ID = 'errorCodeText';
    const ERROR_PARAM_SELECTOR = '[data-error-param]';

    const applyErrorDetails = () => {
        // Get errorCode from url, so it doesn't need to be passed
        // in from Astro and we can import in this script
        const errorCode = parseInt(window.location.pathname.split('/').filter(Boolean).slice(-1)[0], 10);
        const searchParams = new URLSearchParams(window.location.search);
        const { _version_, ...params } = Object.fromEntries(searchParams.entries());

        // Redirect first, so the hop to the archive never sits downstream of a failing text lookup.
        const errorRedirectBaseUrl = _version_
            ? getErrorRedirectBaseUrl({ errorVersion: _version_, pageVersion: VERSION })
            : undefined;

        if (errorRedirectBaseUrl) {
            // `replace` does not halt this script, so everything below has to be an explicit `else`.
            const redirectUrl = pathJoin(errorRedirectBaseUrl, window.location.pathname, window.location.search);
            window.location.replace(redirectUrl);
        } else if (errorCode in AG_GRID_ERRORS) {
            const typedErrorCode = errorCode as ErrorId;

            const { text, hasPlaceholders } = getErrorTextDetails({ errorCode: typedErrorCode, params });

            const errorCodeTextEl = document.getElementById(ERROR_CODE_TEXT_ID);
            if (errorCodeTextEl) {
                errorCodeTextEl.textContent = text;
            }

            // Hidden until now, so a complete message never flashes the warning.
            const missingParamsEl = document.getElementById(MISSING_PARAMS_ID);
            if (hasPlaceholders) {
                missingParamsEl?.removeAttribute('hidden');
            } else {
                missingParamsEl?.remove();
            }

            // Swap each `errorParam` fallback for this reader's own value.
            for (const el of document.querySelectorAll<HTMLElement>(ERROR_PARAM_SELECTOR)) {
                const name = el.dataset.errorParam;
                const value = name === undefined ? undefined : params[name];
                if (value !== undefined) {
                    el.textContent = `${formatErrorParamValue(value)}${el.dataset.errorParamSuffix ?? ''}`;
                }
            }
        }
    };

    applyErrorDetails();
    // A module does not re-run after a `<ClientRouter />` swap, so switching framework would otherwise
    // leave the freshly served page's message unrendered and its warning still hidden.
    document.addEventListener('astro:page-load', applyErrorDetails);
</script>
