---
import { Icon } from '@ag-website-shared/components/icon/Icon';
import { LicensePricing } from '@ag-website-shared/components/license-pricing/LicensePricing';
import styles from '@ag-website-shared/components/license-pricing/license-pricing.module.scss';
import { PRICING_ANCHORS, PRICING_HERO } from '@ag-website-shared/components/license-pricing/pricingContent';
import PageHero from '@ag-website-shared/components/page-hero/PageHero.astro';
import Layout from '@layouts/Layout.astro';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';
import { DISABLE_MARKDOWN_DOCS } from '@constants';

const markdownUrl = DISABLE_MARKDOWN_DOCS ? undefined : urlWithBaseUrl('/license-pricing.md');
---

<Layout
    title="Pricing: AG Grid, AG Charts and AG Studio"
    description="Pricing for AG Grid, AG Charts and AG Studio. Start free with Community, buy Enterprise licences online for a small team, or contact sales for tailored pricing for your application."
    showSearchBar={true}
    showDocsNav={false}
    showMicrosoftMessage={true}
    markdownUrl={markdownUrl}
>
    <PageHero eyebrow={PRICING_HERO.eyebrow} headline={PRICING_HERO.headline} subhead={PRICING_HERO.intro}>
        <a class:list={['button', styles.heroAction]} href={`#${PRICING_ANCHORS.products}`}>
            <Icon name="arrowDown" />
            Explore products
        </a>
        <a class:list={['button-secondary', styles.heroAction]} href={`#${PRICING_ANCHORS.contact}`}>
            <Icon name="email" />
            Contact sales
        </a>
    </PageHero>
    <LicensePricing client:load defaultSelection="grid" />
</Layout>

<script is:inline defer src={urlWithBaseUrl('/scripts/license-pricing.js')}></script>
