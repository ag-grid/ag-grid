---
import LicensePricingPage from '@ag-website-shared/components/license-pricing/LicensePricingPage.astro';
import { PRICING_PAGE } from '@ag-website-shared/components/license-pricing/pricingContent';
import Layout from '@layouts/Layout.astro';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';
import { DISABLE_MARKDOWN_DOCS } from '@constants';

const markdownUrl = DISABLE_MARKDOWN_DOCS ? undefined : urlWithBaseUrl('/license-pricing.md');
---

<Layout
    title={PRICING_PAGE.title}
    description={PRICING_PAGE.description}
    showSearchBar={true}
    showDocsNav={false}
    showMicrosoftMessage={true}
    markdownUrl={markdownUrl}
>
    <LicensePricingPage defaultSelection="grid" />
</Layout>
