---
import BryntumCampaign from '@components/campaigns-components/BryntumCampaign.astro';
import type { BryntumCampaignContent } from '@components/campaigns-components/bryntum/types';
import Layout from '@layouts/Layout.astro';
import { loadBryntumCampaigns } from '@utils/bryntumCampaigns';
import { campaignMeta } from '@utils/markdown-pages/buildCampaignMarkdown';

export function getStaticPaths() {
    return loadBryntumCampaigns().map(({ urlSlug, content }) => ({
        params: { bryntumProduct: urlSlug },
        props: { content },
    }));
}

interface Props {
    content: BryntumCampaignContent;
}

const { content } = Astro.props;
// Shared with the /campaigns/<slug>.md twin so both describe the page identically.
const { title: pageTitle, description: pageDescription } = campaignMeta(content);

// Per-product Open Graph images.
const ogImageBasePath = '/images/campaigns/bryntum-products/opengraph-images';
const socialImagesBySlug: Record<string, string> = {
    calendar: `${ogImageBasePath}/calendar.webp`,
    gantt: `${ogImageBasePath}/gantt.webp`,
    scheduler: `${ogImageBasePath}/scheduler.webp`,
    taskboard: `${ogImageBasePath}/task-board.webp`,
};
const overrideSocialImage = socialImagesBySlug[content.slug];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    showDocsNav={false}
    showSearchBar={true}
    showAnnouncementBanner={false}
    overrideSocialImage={overrideSocialImage}
>
    <BryntumCampaign content={content} />
</Layout>
