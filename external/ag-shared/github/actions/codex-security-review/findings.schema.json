{
    "type": "object",
    "additionalProperties": false,
    "required": ["summary", "findings"],
    "properties": {
        "summary": {
            "type": "string",
            "description": "One or two sentences on what was reviewed and the overall result"
        },
        "findings": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "severity",
                    "confidence",
                    "category",
                    "title",
                    "file",
                    "line",
                    "description",
                    "exploit_scenario",
                    "recommendation"
                ],
                "properties": {
                    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
                    "confidence": { "type": "string", "enum": ["high", "medium"] },
                    "category": {
                        "type": "string",
                        "description": "Short vulnerability class, e.g. XSS, prototype pollution, command injection, workflow injection, ReDoS"
                    },
                    "title": { "type": "string", "description": "One-line summary of the vulnerability" },
                    "file": { "type": "string", "description": "Path relative to the repository root" },
                    "line": { "type": "integer", "description": "1-indexed line where the vulnerable code is" },
                    "description": { "type": "string", "description": "What is wrong and why it is exploitable" },
                    "exploit_scenario": {
                        "type": "string",
                        "description": "Concrete attacker-controlled input or position and what it achieves"
                    },
                    "recommendation": { "type": "string", "description": "How to fix it" }
                }
            }
        }
    }
}
