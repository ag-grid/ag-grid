---
import { getIsProduction } from '@utils/env';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';

interface Props {
    googleTagManagerId: string;
    googleTagManagerAuth: string;
    googleTagManagerPreview: string;
}

const { googleTagManagerId, googleTagManagerAuth, googleTagManagerPreview } = Astro.props as Props;
// Every build but production and archive (which count as production) loads GTM's staging
// environment, so tags can be tried on staging, branch deploys and local previews before they are
// published. Left on Live if a build has no staging environment configured.
const useStagingEnvironment = !getIsProduction() && googleTagManagerAuth && googleTagManagerPreview;
const extraParams = useStagingEnvironment
    ? `&gtm_auth=${googleTagManagerAuth}&gtm_preview=${googleTagManagerPreview}`
    : '';
---

{
    /* Externalised (was an inline define:vars bootstrap) so the site CSP can drop
    script-src 'unsafe-inline'; config passes via data- attributes. Must stay a
    classic, non-deferred script so document.currentScript resolves in the loader. */
}
<script
    is:inline
    src={urlWithBaseUrl('/scripts/gtm-init.js')}
    data-gtm-id={googleTagManagerId}
    data-gtm-extra={extraParams}></script>
