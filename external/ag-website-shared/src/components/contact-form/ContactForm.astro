---
import { getIsProduction, getIsDev } from '@utils/env';
import { CONTACT_FORM_DATA, RECAPTCHA_SITE_KEY } from '@ag-website-shared/constants';
import { SITE_URL, SITE_BASE_URL } from '@constants';
import { pathJoin } from '@utils/pathJoin';

import './ContactForm.module.scss';

const { actionUrl, orgId, textAreaId } = getIsProduction() ? CONTACT_FORM_DATA.production : CONTACT_FORM_DATA.default;

const isDev = getIsDev();
const showCaptcha = !isDev;
const insertHiddenFields = isDev;
const returnUrl = pathJoin(SITE_URL, SITE_BASE_URL);
---

{showCaptcha && <script is:inline src="https://www.google.com/recaptcha/api.js" />}

<script>
    import { addDebugHiddenFields } from '@ag-website-shared/components/contact-form/addDebugHiddenFields';
    import { initCaptcha } from '@ag-website-shared/components/contact-form/initCaptcha';

    const form = document.getElementById('ag-contact-form') as HTMLFormElement;
    if (form) {
        const insertHiddenFields = form.dataset.insertHiddenFields === 'true';
        addDebugHiddenFields({ form, insert: insertHiddenFields });
    }

    const showCaptcha = form?.dataset.showCaptcha === 'true';
    if (showCaptcha) {
        initCaptcha();
    }
</script>

<form
    id="ag-contact-form"
    action={actionUrl}
    method="POST"
    data-insert-hidden-fields={insertHiddenFields}
    data-show-captcha={showCaptcha}
>
    <input
        type="hidden"
        name="captcha_settings"
        value={`{"keyname":"agGridCom","fallback":"true","orgId":"${orgId}","ts":""}`}
    />
    <input type="hidden" name="oid" value={orgId} />
    <input type="hidden" name="retURL" value={returnUrl} />

    <div class="input-field">
        <label for="first_name">First Name</label><input
            id="first_name"
            maxlength="40"
            name="first_name"
            size="20"
            type="text"
        />
    </div>
    <div class="input-field">
        <label for="last_name">Last Name</label><input
            id="last_name"
            maxlength="80"
            name="last_name"
            size="20"
            type="text"
        />
    </div>
    <div class="input-field">
        <label for="email">Email</label><input id="email" maxlength="80" name="email" size="20" type="text" />
    </div>
    <div class="input-field">
        <label for={textAreaId}>Enquiry Message</label><textarea id={textAreaId} name={textAreaId} rows="3" wrap="soft"
        ></textarea>
    </div>

    {showCaptcha && <div class="g-recaptcha" data-sitekey={RECAPTCHA_SITE_KEY} />}

    <input type="submit" name="submit" />
</form>
