---
import Layout from '@layouts/Layout.astro';
import CommunityMenu from '@ag-website-shared/components/community/components/CommunityMenu';
import styles from './CommunityLayout.module.scss';
import menu from '@ag-website-shared/content/community/community-menu.json';
import { DISABLE_MARKDOWN_DOCS } from '@constants';

interface Props {
    title: string;
    description: string;
    pageTitle: string;
}

const { title, description, pageTitle } = Astro.props as Props;

// Every community page has a markdown twin at `<page>.md` (see the community *.md.ts routes); point
// the alternate link at it. The pathname already carries the site base, so no urlWithBaseUrl here.
const markdownUrl = DISABLE_MARKDOWN_DOCS ? undefined : `${Astro.url.pathname.replace(/\/$/, '')}.md`;
---

<Layout showSearchBar={true} showDocsNav={false} title={title} description={description} markdownUrl={markdownUrl}>
    <div class="layout-max-width-large">
        <div class={styles.header}>
            <CommunityMenu client:load path={Astro.url.pathname} menu={menu} />
        </div>
        <div class="layout-max-width-small">
            <div class={styles.container}>
                <div class={styles.content}>
                    <!-- Title -->
                    <h1 class={styles.title}>{pageTitle}</h1>
                    <slot />
                </div>
            </div>
        </div>
    </div>
</Layout>
