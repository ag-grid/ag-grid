---
import styles from '../DecisionPage.module.scss';
import { FEATURE_STATUS, type FeatureCellTone, featureCellLabel, featureCellTone } from '../decisionPageText';
import type { FeatureCell, FeatureGroup } from '../types';
import ProductHeading from './ProductHeading.astro';

interface Props {
    groups: FeatureGroup[];
    product: { name: string; logo?: string };
    competitor: { name: string; logo?: string };
    resolveUrl: (url: string) => string;
}

const { groups, product, competitor, resolveUrl } = Astro.props;

const TONE_CLASS: Record<FeatureCellTone, string> = {
    free: styles.pillFree,
    paid: styles.pillPaid,
    limited: styles.pillLimited,
    none: styles.pillNone,
};

const cells = (row: FeatureGroup['rows'][number]): FeatureCell[] => [row.product, row.competitor];
---

<div class={styles.tableWrapper}>
    <table class={styles.table}>
        <colgroup>
            <col class={styles.featureColumn} />
            <col class={styles.productColumn} />
            <col class={styles.competitorColumn} />
        </colgroup>
        <thead>
            <tr>
                <th scope="col">Feature</th>
                <th scope="col">
                    <ProductHeading name={product.name} logo={product.logo} />
                </th>
                <th scope="col">
                    <ProductHeading name={competitor.name} logo={competitor.logo} />
                </th>
            </tr>
        </thead>
        {groups.map((group) => (
            <tbody>
                <tr class={styles.groupRow}>
                    <th scope="rowgroup">{group.name}</th>
                    {/* Empty cells rather than a colspan, so the product column's tint runs through the row */}
                    <td />
                    <td />
                </tr>
                {group.rows.map((row) => (
                    <tr>
                        <th scope="row">
                            {row.docsUrl ? <a href={resolveUrl(row.docsUrl)}>{row.feature}</a> : row.feature}
                        </th>
                        {cells(row).map((value) => (
                            <td>
                                <span class:list={[styles.pill, TONE_CLASS[featureCellTone(value)]]}>
                                    <span aria-hidden="true">{FEATURE_STATUS[value.status].symbol}</span>
                                    {featureCellLabel(value)}
                                </span>
                                {value.detail && <div class={styles.cellDetail}>{value.detail}</div>}
                            </td>
                        ))}
                    </tr>
                ))}
            </tbody>
        ))}
    </table>
</div>
