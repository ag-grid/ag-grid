---
import styles from '../DecisionPage.module.scss';
import { ctaAttributes } from '../decisionPageCta';
import { HERO_CTAS, chooseIfHeading } from '../decisionPageText';
import type { DecisionPageSite } from '../types';

interface Props {
    /** The product's own option ends with a get-started link. */
    options: Array<{ name: string; reasons: string[]; isProduct?: boolean }>;
    site: DecisionPageSite;
    analyticsPrefix: string;
}

const { options, site, analyticsPrefix } = Astro.props;
const getStarted = ctaAttributes({ site, analyticsPrefix, action: 'get-started', placement: 'choose-if' });
---

<div class={styles.chooseIf}>
    {options.map(({ name, reasons, isProduct }) => (
        <div class:list={[styles.chooseIfCard, isProduct && styles.chooseIfProduct]}>
            <h3>{chooseIfHeading(name)}</h3>
            <ul>
                {reasons.map((reason) => (
                    <li>{reason}</li>
                ))}
            </ul>
            {isProduct && (
                <a
                    {...getStarted.attributes}
                    class:list={['button', styles.chooseIfCta, getStarted.analyticsClass]}
                    href={site.resolveUrl(site.urls.getStarted)}
                >
                    {HERO_CTAS.getStarted}
                </a>
            )}
        </div>
    ))}
</div>
