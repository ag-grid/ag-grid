---
import { Icon } from '@ag-website-shared/components/icon/Icon';

import styles from '../DecisionPage.module.scss';
import { ctaAttributes } from '../decisionPageCta';
import { COMPARISON_SECTIONS, GET_STARTED_CTAS } from '../decisionPageText';
import type { DecisionPageSite } from '../types';

interface Props {
    site: DecisionPageSite;
    analyticsPrefix: string;
}

const { site, analyticsPrefix } = Astro.props;
const getStarted = ctaAttributes({ site, analyticsPrefix, action: 'get-started', placement: 'get-started' });
const trial = ctaAttributes({ site, analyticsPrefix, action: 'trial', placement: 'get-started' });
const ctas = [
    { cta: getStarted, href: site.urls.getStarted, label: GET_STARTED_CTAS.docs },
    { cta: trial, href: site.urls.trial, label: GET_STARTED_CTAS.trial },
];
---

<div class={styles.getStarted}>
    <p class={styles.getStartedEyebrow} aria-hidden="true">
        {COMPARISON_SECTIONS.getStarted}
    </p>
    <h3>{site.getStarted.heading}</h3>
    <p>{site.getStarted.body}</p>
    <div class={styles.getStartedCtas}>
        {ctas.map(({ cta, href, label }) => (
            <a
                {...cta.attributes}
                class:list={['button-tertiary', styles.getStartedCta, cta.analyticsClass]}
                href={site.resolveUrl(href)}
            >
                {label}
                <Icon name="chevronRight" svgClasses={styles.getStartedCtaIcon} />
            </a>
        ))}
    </div>
</div>
