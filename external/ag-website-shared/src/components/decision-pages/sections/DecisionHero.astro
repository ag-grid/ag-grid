---
import PageHero from '@ag-website-shared/components/page-hero/PageHero.astro';

import styles from '../DecisionPage.module.scss';
import { ctaAttributes } from '../decisionPageCta';
import { HERO_CTAS, formatLastUpdated, toIsoDate } from '../decisionPageText';
import type { DecisionPageSite } from '../types';

interface Props {
    site: DecisionPageSite;
    /** The cluster name shown in the breadcrumb, e.g. `Compare`. */
    hubName: string;
    /** The current page's short name, the breadcrumb's last item, e.g. `AG Grid vs MUI X`. */
    pageName: string;
    heading: string;
    subHeading: string;
    lastUpdated: Date;
    analyticsPrefix: string;
    /** Logo URLs shown side by side above the heading, when both are known. */
    logos?: { product?: string; competitor?: string };
}

const { site, hubName, pageName, heading, subHeading, lastUpdated, analyticsPrefix, logos } = Astro.props;
const getStarted = ctaAttributes({ site, analyticsPrefix, action: 'get-started', placement: 'hero' });
const demo = ctaAttributes({ site, analyticsPrefix, action: 'demo', placement: 'hero' });
---

<PageHero headline={heading} subhead={subHeading}>
    <nav slot="eyebrow" class={styles.breadcrumbs} aria-label="Breadcrumb">
        <a href={site.resolveUrl(site.urls.home)}>{site.productName}</a> /{' '}
        <a href={site.resolveUrl(site.urls.hub)}>{hubName}</a> /{' '}
        <span class={styles.breadcrumbCurrent} aria-current="page">
            {pageName}
        </span>
    </nav>
    {/* Decorative: the heading names both products */}
    {logos?.product && logos.competitor && (
        <div slot="media" class={styles.heroLogos} aria-hidden="true">
            <img src={logos.product} alt="" width="48" height="48" />
            <span class={styles.heroLogosVs}>vs</span>
            <img src={logos.competitor} alt="" width="48" height="48" />
        </div>
    )}
    <div class={styles.heroCtas}>
        <a
            {...getStarted.attributes}
            class:list={['button', getStarted.analyticsClass]}
            href={site.resolveUrl(site.urls.getStarted)}
        >
            {HERO_CTAS.getStarted}
        </a>
        <a
            {...demo.attributes}
            class:list={['button-tertiary', demo.analyticsClass]}
            href={site.resolveUrl(site.urls.demo)}
        >
            {HERO_CTAS.demo}
        </a>
    </div>
    <div class={styles.heroMeta}>
        <p>
            Last updated <time datetime={toIsoDate(lastUpdated)}>{formatLastUpdated(lastUpdated)}</time>
        </p>
        <slot name="review-credit" />
    </div>
</PageHero>
