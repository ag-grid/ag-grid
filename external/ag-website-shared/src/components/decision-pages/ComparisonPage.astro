---
/**
 * The comparison page template (`/compare/{product}-vs-{competitor}/`), shared by AG Grid,
 * AG Charts and AG Studio. It renders page content only: each site wraps it in its own Layout,
 * passing the JSON-LD from `buildDecisionPageStructuredData` plus its reviewer nodes.
 *
 * Slots:
 * - review-credit: the site's "Technically reviewed by" credit, rendered at the end of the page.
 *
 * Section order and labels match `buildComparisonPageMarkdown`, the page's `.md` twin.
 */
import { LandingPageFAQ } from '@ag-website-shared/components/landing-pages/LandingPageFAQ';
import { renderFAQAnswers, renderMarkdocHtml } from '@ag-website-shared/components/landing-pages/renderFAQAnswers';

import styles from './DecisionPage.module.scss';
import { COMPARISON_SECTIONS } from './decisionPageText';
import ChooseIf from './sections/ChooseIf.astro';
import DecisionHero from './sections/DecisionHero.astro';
import DecisionSection from './sections/DecisionSection.astro';
import FeatureMatrix from './sections/FeatureMatrix.astro';
import GetStartedPanel from './sections/GetStartedPanel.astro';
import KeyFigures from './sections/KeyFigures.astro';
import PricingTables from './sections/PricingTables.astro';
import RelatedPages from './sections/RelatedPages.astro';
import type { ComparisonPageContent, DecisionPageSite, RelatedPageGroup } from './types';

interface Props {
    content: ComparisonPageContent;
    site: DecisionPageSite;
    /** The cluster name shown in the breadcrumb. */
    hubName: string;
    related: RelatedPageGroup[];
}

const { content, site, hubName, related } = Astro.props;
const { productName } = site;
const competitorName = content.competitor.name;
const product = { name: productName, logo: site.productLogo };
const competitor = {
    name: competitorName,
    logo: content.competitor.logo && site.resolveUrl(content.competitor.logo),
};
---

<DecisionHero
    site={site}
    hubName={hubName}
    heading={content.hero.heading}
    subHeading={content.hero.subHeading}
    lastUpdated={content.lastUpdated}
    analyticsPrefix={content.analyticsPrefix}
/>

<DecisionSection
    id="short-answer"
    eyebrow={`${productName} vs ${competitorName}`}
    heading={COMPARISON_SECTIONS.shortAnswer}
>
    <div class={styles.shortAnswer} set:html={renderMarkdocHtml(content.shortAnswer, site.framework)} />
</DecisionSection>

<DecisionSection id="key-differences" heading={COMPARISON_SECTIONS.keyFigures}>
    <KeyFigures figures={content.keyFigures} />
</DecisionSection>

<DecisionSection id="features" heading={COMPARISON_SECTIONS.features} subHeading={content.features.subHeading}>
    <FeatureMatrix
        groups={content.features.groups}
        product={product}
        competitor={competitor}
        resolveUrl={site.resolveUrl}
    />
</DecisionSection>

<DecisionSection id="pricing" heading={COMPARISON_SECTIONS.pricing} subHeading={content.pricing.subHeading}>
    <PricingTables
        tables={[
            { ...product, rows: content.pricing.product },
            { ...competitor, rows: content.pricing.competitor },
        ]}
        productName={productName}
        pricingUrl={site.resolveUrl(site.urls.pricing)}
    />
</DecisionSection>

<DecisionSection id="choose" heading={COMPARISON_SECTIONS.chooseIf}>
    <ChooseIf
        options={[
            { name: productName, reasons: content.chooseIf.product, isProduct: true },
            { name: competitorName, reasons: content.chooseIf.competitor },
        ]}
    />
</DecisionSection>

{content.faq.length > 0 && (
    <DecisionSection id="faq" heading={COMPARISON_SECTIONS.faq}>
        <LandingPageFAQ
            client:load
            FAQData={renderFAQAnswers(content.faq, site.framework)}
            analyticsEventName={`${content.analyticsPrefix}-expand-faq`}
        />
    </DecisionSection>
)}

<DecisionSection id="get-started" heading={COMPARISON_SECTIONS.getStarted} headingHidden>
    <GetStartedPanel site={site} analyticsPrefix={content.analyticsPrefix} />
</DecisionSection>

{related.length > 0 && (
    <DecisionSection id="related" heading={COMPARISON_SECTIONS.related}>
        <RelatedPages groups={related} resolveUrl={site.resolveUrl} />
    </DecisionSection>
)}

<slot name="review-credit" />
