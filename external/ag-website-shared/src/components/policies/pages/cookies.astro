---
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';

import Layout from '@layouts/Layout.astro';

import { POLICY_CONTENT } from '../policyContent';
import styles from '../cookiesPolicyPage.module.scss';

interface Props {
    name: string;
    /**
     * Enzuzo policy UUID. Site-specific, so each product site passes its own — the embed renders
     * the cookie policy belonging to whichever UUID it is given.
     */
    enzuzoPolicyId: string;
}

const { name, enzuzoPolicyId } = Astro.props;
// The embed supplies the page heading and body; only the document metadata is ours (AG-18194).
const content = POLICY_CONTENT.cookies;
---

<Layout
    title={`${name}: ${content.metaTitle}`}
    description={content.description}
    showSearchBar={true}
    showDocsNav={false}
>
    <div class:list={styles.cookiesPage}>
        <div class="layout-max-width-small">
            {
                /* The cookie policy is generated by Enzuzo, our consent-management platform, from an
        automated scan of the site, rather than maintained by hand here (AG-18194).

        The loader inserts the policy as a *sibling after its own <script>* and leaves
        #__enzuzo-root empty, so the script has to sit inside the wrapper the content should lay
        out in — moving it out of here silently reparents the whole policy.

        is:inline keeps Astro from bundling and hoisting it (which would break that positioning),
        and data-astro-rerun re-runs it after a client-side navigation back to this page —
        otherwise Astro treats it as already executed and the page renders empty. Re-running is
        safe: the loader drops any previously injected [ez-policy-mode] before inserting. */
            }
            <div id="__enzuzo-root"></div>
            <script
                is:inline
                data-astro-rerun
                id="__enzuzo-root-script"
                src={`https://app.enzuzo.com/scripts/cookies/${enzuzoPolicyId}`}></script>

            {
                /* Strips the vendor's self-promotional section from the injected policy; see
        public/scripts/enzuzo-policy-tidy.js. Externalised to a 'self' script so the site CSP
        can keep script-src free of 'unsafe-inline' without needing a per-build hash, and
        re-run alongside the loader above so it observes the re-injected policy too. */
            }
            <script is:inline data-astro-rerun src={urlWithBaseUrl('/scripts/enzuzo-policy-tidy.js')}></script>
        </div>
    </div>
</Layout>
