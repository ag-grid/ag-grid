---
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';

import Layout from '@layouts/Layout.astro';

import { POLICY_CONTENT } from '../policyContent';
import styles from '../cookiesPolicyPage.module.scss';

interface Props {
    name: string;
    /**
     * Enzuzo policy UUID. Site-specific, so each product site passes its own — the embed renders
     * the cookie policy belonging to whichever UUID it is given.
     */
    enzuzoPolicyId: string;
}

const { name, enzuzoPolicyId } = Astro.props;
// The embed supplies the page heading and body; only the document metadata is ours (AG-18194).
const content = POLICY_CONTENT.cookies;
---

<Layout
    title={`${name}: ${content.metaTitle}`}
    description={content.description}
    showSearchBar={true}
    showDocsNav={false}
>
    <div class:list={styles.cookiesPage}>
        <div class="layout-max-width-small">
            {
                /* The cookie policy is generated by Enzuzo, our consent-management platform, from an
        automated scan of the site, rather than maintained by hand here (AG-18194).

        The vendor loader is deliberately NOT a <script> tag here: it inserts the policy with
        `Range.createContextualFragment`, which — unlike innerHTML — yields *executable* scripts,
        and the policy HTML carries three inline <script>s the site CSP refuses. They are stripped
        by patching `createContextualFragment` in enzuzo-policy-embed below, which only works if
        the patch is installed before the loader runs. As two sibling <script src> tags that
        ordering is a race: on a full page load the tidy script has to win a network round trip,
        and on an Astro client-side navigation ClientRouter re-inserts both via createElement,
        which makes them async and drops document order altogether. So the loader is injected by
        that script instead, after the patch is in place — ordering by construction rather than by
        timing (AG-18194).

        The loader inserts the policy as a *sibling after its own <script>*, so it is appended into
        the wrapper the content should lay out in, and #__enzuzo-root is left empty.

        is:inline keeps Astro from bundling and hoisting it, and data-astro-rerun re-runs it after a
        client-side navigation back to this page — otherwise Astro treats it as already executed and
        the page renders empty. Re-running is safe: the loader drops any previously injected
        [ez-policy-mode] before inserting.

        NB the data attribute deliberately avoids the substring `ez-`: the vendor loader scans every
        <script> on the page and treats any attribute matching /ez-\w+/ as a policy-mode marker,
        which would make it mistake this tag for a second policy embed. */
            }
            <div id="__enzuzo-root"></div>
            <script
                is:inline
                data-astro-rerun
                data-policy-loader-src={`https://app.enzuzo.com/scripts/cookies/${enzuzoPolicyId}`}
                src={urlWithBaseUrl('/scripts/enzuzo-policy-embed.js')}></script>
        </div>
    </div>
</Layout>
