---
import styles from './ExpandingSection.module.scss';

interface Props {
    headerText: string;
    isOpen?: boolean;
}

const sectionContent = await Astro.slots.render('default');

const { headerText, isOpen = false } = Astro.props as Props;
---

<expanding-section class={styles.expandingSection} data-is-open={isOpen}>
    <button class:list={[styles.expandingSectionHeader, 'button-secondary']}>{headerText}</button>

    <div class:list={[styles.expandingSectionContentOuter, 'es-content-outer']}>
        <div class:list={[styles.expandingSectionContentInner, 'es-content-inner']}>
            <Fragment set:html={sectionContent} />
        </div>
    </div>
</expanding-section>

<script>
    class ExpandingSection extends HTMLElement {
        #isOpen: boolean = false;
        #button: HTMLElement;
        #contentOuter: HTMLElement;
        #contentInner: HTMLElement;

        constructor() {
            super();

            this.#button = this.querySelector('button')!;
            this.#contentOuter = this.querySelector('.es-content-outer')!;
            this.#contentInner = this.querySelector('.es-content-inner')!;

            this.isOpen = this.dataset.isOpen !== undefined;

            // Prevent transition if section is open on init
            if (this.isOpen) this.style.setProperty('--content-height', 'none');

            this.#button.addEventListener('click', () => {
                this.isOpen = !this.isOpen;
            });

            this.#contentOuter.addEventListener('transitionend', () => {
                if (this.isOpen) this.style.setProperty('--content-height', 'none');
            });
        }

        get isOpen() {
            return this.#isOpen;
        }

        set isOpen(v) {
            if (this.#isOpen === v) return;

            this.#isOpen = v === true;

            if (this.#isOpen) {
                this.#open();
            } else {
                this.#close();
            }
        }

        get #contentHeight() {
            return this.#contentInner.offsetHeight;
        }

        #open() {
            const contentHeight = this.#contentHeight;
            const transitionTiming = Math.max(contentHeight / 1250, 0.25);

            this.setAttribute('data-is-open', 'data-is-open');

            this.style.setProperty('--content-transition-timing', `${transitionTiming}s`);
            this.style.setProperty('--content-height', `${contentHeight + 2}px`);
        }

        #close() {
            const contentHeight = this.#contentHeight;
            const transitionTiming = Math.max(contentHeight / 1250, 0.25);

            this.removeAttribute('data-is-open');

            // Set a specific height, as you can't transition from `max-height: none`
            this.style.setProperty('--content-height', `${contentHeight + 2}px`);
            document.documentElement.offsetHeight; // Trigger a reflow, flushing the CSS changes

            this.style.setProperty('--content-transition-timing', `${transitionTiming}s`);
            this.style.setProperty('--content-height', `0px`);
        }
    }

    customElements.define('expanding-section', ExpandingSection);
</script>
