---
interface Props {
    version: string;
    documentationId?: string;
}
import { agLibraryVersion } from '@constants';

const { version, documentationId = 'documentation' } = Astro.props as Props;
---

<span hidden data-documentation-id={documentationId} data-version={version} data-library-version={agLibraryVersion}
></span>
<script src="./hideDocumentationLinkIfLatest"></script>
