---
import { ArchiveLink } from './ArchiveLink';
import type { Library } from '@ag-grid-types';
import HideDocumentationLinkIfLatest from '@ag-website-shared/components/documentation-archive/HideDocumentationLinkIfLatest.astro';

interface Props {
    site: Library;
    version: string;
}

const { site, version } = Astro.props as Props;
---

<ArchiveLink version={version} site={site} useDocumentationLink />
<HideDocumentationLinkIfLatest version={version} />
